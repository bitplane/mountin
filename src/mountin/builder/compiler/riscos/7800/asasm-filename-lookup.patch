+#ifndef __riscos__
+/* Resolve each component before looking for an implicit filetype suffix.  */
+static bool
+ASFile_Resolve (const char *fileName, char *resolved, size_t size)
+{
+  if (size < 2)
+    return true;
+  const bool absolute = fileName[0] == '/';
+  snprintf (resolved, size, "%s", absolute ? "/" : ".");
+  const char *component = fileName + absolute;
+  while (*component != '\0')
+    {
+      while (*component == '/')
+        ++component;
+      if (*component == '\0')
+        break;
+      const char *end = strchr (component, '/');
+      size_t length = end == NULL ? strlen (component) : (size_t)(end - component);
+      size_t used = strlen (resolved);
+      size_t prefix = used + (resolved[used - 1] != '/');
+      if (prefix + length >= size)
+        return true;
+
+      resolved[prefix - 1] = '/';
+      memcpy (resolved + prefix, component, length);
+      resolved[prefix + length] = '\0';
+      struct stat sinfo;
+      if (stat (resolved, &sinfo) != 0)
+        {
+          resolved[used] = '\0';
+          DIR *directory = opendir (resolved);
+          if (directory == NULL)
+            return true;
+
+          unsigned best = 0;
+          bool ambiguous = false;
+          bool fileType = end == NULL
+                          && !(length > 4 && component[length - 4] == ',');
+          struct dirent *entry;
+          errno = 0;
+          while ((entry = readdir (directory)) != NULL)
+            {
+              size_t entryLen = strlen (entry->d_name);
+              bool suffix = fileType && entryLen == length + 4
+                            && entry->d_name[length] == ','
+                            && isxdigit ((unsigned char)entry->d_name[length + 1])
+                            && isxdigit ((unsigned char)entry->d_name[length + 2])
+                            && isxdigit ((unsigned char)entry->d_name[length + 3]);
+              if ((entryLen != length && !suffix)
+                  || strncasecmp (entry->d_name, component, length) != 0)
+                continue;
+              /* Prefer unsuffixed names, then exact case within each group.  */
+              unsigned rank = suffix ? 1 : 3;
+              if (memcmp (entry->d_name, component, length) == 0)
+                ++rank;
+              if (rank < best)
+                continue;
+              if (rank == best)
+                {
+                  ambiguous = true;
+                  continue;
+                }
+              if (prefix + entryLen >= size)
+                {
+                  closedir (directory);
+                  return true;
+                }
+              resolved[prefix - 1] = '/';
+              memcpy (resolved + prefix, entry->d_name, entryLen + 1);
+              best = rank;
+              ambiguous = false;
+            }
+          int readError = errno;
+          closedir (directory);
+          if (readError != 0 || best == 0)
+            return true;
+          if (ambiguous)
+            {
+              Error (ErrorError, "Ambiguous filename component '%.*s' in '%s'",
+                     (int)length, component, fileName);
+              return true;
+            }
+        }
+      if (end != NULL
+          && (stat (resolved, &sinfo) != 0 || !S_ISDIR (sinfo.st_mode)))
+        return true;
+      component = end == NULL ? component + length : end + 1;
+    }
+  return false;
+}
+#endif
