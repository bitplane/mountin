+static bool
+divide (bool doLowerCase, ARMWord opcode)
+{
+  ARMWord cc = Option_Cond (doLowerCase);
+  if (cc == kOption_NotRecognized)
+    return true;
+
+  InstrWidth_e width = Option_GetInstrWidth (doLowerCase);
+  if (width == eInstrWidth_Unrecognized)
+    return true;
+  if (width == eInstrWidth_Enforce16bit)
+    Error (ErrorError, "Narrow instruction qualifier for divide is not possible");
+
+  InstrType_e state = State_GetInstrType ();
+  bool thumb = state != eInstrType_ARM;
+  if (thumb || !Target_CheckCPUFeature (kCPUExt_Virt, false))
+    Target_CheckCPUFeature (thumb ? kCPUExt_Div : kCPUExt_ADIV, true);
+  IT_ApplyCond (cc, false, thumb);
+
+  unsigned regD = Get_CPUReg ();
+  Input_SkipWS ();
+  if (!Input_Match (',', true))
+    Error (ErrorError, "%sdst", InsertCommaAfter);
+  unsigned regN = Get_CPUReg ();
+  Input_SkipWS ();
+  if (!Input_Match (',', true))
+    Error (ErrorError, "%slhs", InsertCommaAfter);
+  unsigned regM = Get_CPUReg ();
+
+  if (regD == 15 || regN == 15 || regM == 15)
+    Error (ErrorWarning, "Use of register PC is UNPREDICTABLE");
+
+  if (thumb)
+    {
+      if (regD == 13 || regN == 13 || regM == 13)
+        Error (ErrorWarning, "Use of register SP is UNPREDICTABLE");
+      ARMWord base = opcode == 0x0710f010 ? 0xfb90f0f0 : 0xfbb0f0f0;
+      Put_Ins (4, base | (regN << 16) | (regD << 8) | regM);
+    }
+  else
+    Put_Ins (4, cc | opcode | (regD << 16) | (regM << 8) | regN);
+  return false;
+}
+
+/**
+ * Implements SDIV.
+ *   SDIV<cond> <Rd>, <Rn>, <Rm>
+ */
+bool
+m_sdiv (bool doLowerCase)
+{
+  return divide (doLowerCase, 0x0710f010);
+}
+
+/**
+ * Implements UDIV.
+ *   UDIV<cond> <Rd>, <Rn>, <Rm>
+ */
+bool
+m_udiv (bool doLowerCase)
+{
+  return divide (doLowerCase, 0x0730f010);
+}
