+#ifndef __riscos__
+static bool
+resolve_case_insensitive (const char *fileName, char *resolved, size_t size)
+{
+  const bool absolute = fileName[0] == '/';
+  int written = snprintf (resolved, size, "%s", absolute ? "/" : ".");
+  if (written < 0 || (size_t) written >= size)
+    return true;
+
+  const char *component = fileName + absolute;
+  while (*component != '\0')
+    {
+      while (*component == '/')
+        ++component;
+      if (*component == '\0')
+        break;
+
+      const char *end = strchr (component, '/');
+      size_t length = end == NULL ? strlen (component) : (size_t)(end - component);
+      DIR *directory = opendir (resolved);
+      if (directory == NULL)
+        return true;
+
+      const char *match = NULL;
+      struct dirent *entry;
+      while ((entry = readdir (directory)) != NULL)
+        if (strlen (entry->d_name) == length
+            && strncasecmp (entry->d_name, component, length) == 0)
+          {
+            match = entry->d_name;
+            break;
+          }
+      if (match == NULL)
+        {
+          closedir (directory);
+          return true;
+        }
+
+      size_t used = strlen (resolved);
+      written = snprintf (resolved + used, size - used, "%s%s",
+                          used == 1 && resolved[0] == '/' ? "" : "/", match);
+      closedir (directory);
+      if (written < 0 || (size_t) written >= size - used)
+        return true;
+      component = end == NULL ? component + length : end + 1;
+    }
+  return false;
+}
+#endif
