--- /dev/null
+++ b/s/gcccallbacks
@@ -0,0 +1,35 @@
+        AREA    |Asm$$Code|, CODE, READONLY
+
+        EXPORT  dispatch_card_interrupt
+        EXPORT  dispatch_op_callback
+
+; void dispatch_card_interrupt(void *handler, void *pw)
+dispatch_card_interrupt ROUT
+        STMFD   sp!, {lr}
+        MOV     r12, r1
+        BLX     r0
+        LDMFD   sp!, {pc}
+
+; void dispatch_op_callback(_kernel_oserror *e, void *callback,
+;     uint32_t total_length, uint32_t callback_r5, uint32_t callback_r12)
+dispatch_op_callback ROUT
+        LDR     r12, [sp]
+        STMFD   sp!, {r4-r6,lr}
+        MOV     r6, r1
+        MOV     r4, r2
+        MOV     r5, r3
+        CMP     r0, #0
+        BEQ     %FT10
+        MRS     r1, CPSR
+        ORR     r1, r1, #(1:SHL:28)
+        MSR     CPSR_f, r1
+        B       %FT20
+10
+        MRS     r1, CPSR
+        BIC     r1, r1, #(1:SHL:28)
+        MSR     CPSR_f, r1
+20
+        BLX     r6
+        LDMFD   sp!, {r4-r6,pc}
+
+        END
