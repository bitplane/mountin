diff --git a/GNUmakefile b/GNUmakefile
index ca9b493..1913674 100644
--- a/GNUmakefile
+++ b/GNUmakefile
@@ -172,6 +172,9 @@ ifeq (GNU,${TOOLCHAIN})
 # * gcc doesn't support PCC dialect
 CINCLUDES    = -nostdinc -isystem ${LIBDIR}/CLib -isystem ${LIBDIR}/RISC_OSLib
 CFLAGS       +=  ${C_NO_ZI}
+CFLAGS       += -D__APCS_32 -D__arm
+# The shared library contains runtime-selected ARMv7 routines in its universal image.
+ASFLAGS      += -cpu=Cortex-A7 -fpu=FPE3 -I kernel
 else
 CINCLUDES    = -j${LIBDIR}/CLib -j${LIBDIR}/RISC_OSLib
 CFLAGS       += -fk ${C_NO_ZI}
