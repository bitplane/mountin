diff --git a/clib/h/complex b/clib/h/complex
--- a/clib/h/complex
+++ b/clib/h/complex
@@ -42,10 +42,15 @@
 #define complex      _Complex
    /* a program may undefine and perhaps then redefine the macros complex, */
    /* imaginary, and I. */
 
+#ifdef __GNUC__
+#define _Imaginary_I (__extension__ 1.0iF)
+#define _Complex_I   (__extension__ 1.0iF)
+#else
 #define _Imaginary_I ___i
    /* a constant expression of type const float _Imaginary, with the value */
    /* of the imaginary unit. */
 #define _Complex_I   (0.0F+___i)
+#endif
    /* a constant expression of type const float _Complex, with the value */
    /* of the imaginary unit. */
diff --git a/clib/h/math b/clib/h/math
--- a/clib/h/math
+++ b/clib/h/math
@@ -60,7 +60,12 @@
 #  define HUGE_VALF INFINITY
 #endif
 
+#ifdef __GNUC__
+#define INFINITY __builtin_inff()
+#define NAN      __builtin_nanf("")
+#else
 #define INFINITY 0f_7F800000
    /* a constant expression of type float representing positive infinity */
 #define NAN      0f_7FC00001
+#endif
    /* a constant expression of type float representing a quiet NaN */
