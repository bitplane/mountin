diff --git a/GNUmakefiles/CModule b/GNUmakefiles/CModule
index f5415a2..604448b 100644
--- a/GNUmakefiles/CModule
+++ b/GNUmakefiles/CModule
@@ -172,7 +172,14 @@ TOKHELPDEPENDS ?= ${OBJS}
 ROM_LIBS     ?= ${LIBS}
 SA_LIBS      ?= ${LIBS}
-ROM_LIBS     += ${ROMCSTUBS}
-ROM_SYMS      = ${C_ABSSYM}
+ifeq (GNU,${TOOLCHAIN})
+CMHGFLAGS    += -zbase
+ROM_LIBS     += ${ROMCSTUBS} $(shell ${CC} -print-libgcc-file-name)
+ROM_SYMS      = ${LNK_TARGET}.rom-syms.ld
+ROM_SYM_FLAGS = -T ${ROM_SYMS}
+else
+ROM_LIBS     += ${ROMCSTUBS}
+ROM_SYMS      = ${C_ABSSYM}
+endif
 SA_LIBS      += ${CLIB}
 DBG_LIBS     += ${DEBUGLIBS}
 
@@ -430,10 +430,27 @@ rom_link_: ${LNK_TARGET}.linked
 	@${ECHO} ${COMPONENT}: rom_link complete
 
+ifeq (GNU,${TOOLCHAIN})
+${ROM_SYMS}: ${C_ABSSYM}
+	awk '$$2 == "A" { print "PROVIDE(" $$3 " = " $$1 ");" }' $< > $@
+
+${ROM_TARGET}.aof: ${ROM_DEPEND} ${DIRS} ${ROM_OBJS_} ${ROM_LIBS}
+	${GNUTOOLPREFIX}ld -r -o $@ ${ROM_OBJS_} ${ROM_LIBS}
+
+${LNK_TARGET}.module.ld: /opt/rool/module.ld
+	sed 's/@MODULE_CODE_SECTION@/${TARGET}$$$$Code/g' $< > $@
+
+${LNK_TARGET}.linked: ${FORCEROMLINK} ${ROM_SYMS} ${ROM_TARGET}.aof ${LNK_TARGET}.module.ld
+	${GNUTOOLPREFIX}ld --ro-module-reloc ${ROM_SYM_FLAGS} -T ${LNK_TARGET}.module.ld --defsym=Module_LoadAddr=${ADDRESS} --defsym=Data_LoadAddr=0xFFF00000 \
+		-o $@.elf ${ROM_TARGET}.aof
+	${GNUTOOLPREFIX}objcopy -O binary $@.elf $@
+	${GNUTOOLPREFIX}nm -n $@.elf > ${LNK_TARGET}_sym.linked
+else
 ${ROM_TARGET}.aof: ${ROM_DEPEND} ${DIRS} ${ROM_OBJS_} ${ROM_LIBS}
 	${LD} -o $@ -aof ${ROM_OBJS_} ${ROM_LIBS}
 
 ${LNK_TARGET}.linked: ${FORCEROMLINK} ${ROM_SYMS} ${ROM_TARGET}.aof
 	${LD} ${LDFLAGS} ${LDLINKFLAGS} -o $@ -rmf -base ${ADDRESS} ${ROM_TARGET}.aof ${ROM_SYMS} -Symbols ${LNK_TARGET}_sym.linked
+endif
 
 #
 # Standalone rules
diff --git a/GNUmakefiles/HAL b/GNUmakefiles/HAL
