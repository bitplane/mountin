-Kernel                -at 0xFC010000 -options ASFLAGS="-PD \"CMOS_Override SETS \\\"= FileLangCMOS,fsnumber_SDFS,CDROMFSCMOS,&C0,LanguageCMOS,10\\\"\""
+Kernel                -at 0xFC010000 -options KERNEL_ADDRESS=0xFC010000 ASMDEFINES="-PD \"CMOS_Override SETS \\\"= FileLangCMOS,fsnumber_SDFS,CDROMFSCMOS,&C0,LanguageCMOS,10\\\"\""
 Podule                -type EXP
 PCI
 FileSwitch
