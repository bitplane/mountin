#!/bin/sh
set -eu

if [ "$#" -ne 4 ] || [ "$3" != "-via" ]; then
    echo "usage: resgen area output -via file" >&2
    exit 2
fi

area=$1
case "$area" in
    ''|[0-9]*|*[!a-zA-Z0-9_]*)
        echo "area must be a C identifier: $area" >&2
        exit 2
        ;;
esac

output=$2
via=$4
case "$output" in
    /*) ;;
    *) output=$PWD/$output ;;
esac
case "$via" in
    /*) ;;
    *) via=$PWD/$via ;;
esac

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
root=$temporary/root
mkdir -p "$root"

while read -r source destination; do
    [ -n "$source" ] || continue
    destination=$(printf '%s' "$destination" | tr . /)
    parent=${destination%/*}
    if [ "$parent" != "$destination" ]; then
        mkdir -p "$root/$parent"
    fi
    cp -p "$source" "$root/$destination"
done < "$via"

mkresfs -o "$temporary/generated.c" "$root"
sed -n '/^static const unsigned char payload\[\] =/,/^};/p' \
    "$temporary/generated.c" > "$temporary/resources.c"
test -s "$temporary/resources.c"
cat >> "$temporary/resources.c" <<EOF

void *$area(void)
{
    return (void *)payload;
}
EOF

arm-unknown-riscos-gcc -c -mmodule -mlibscl -march=armv6 \
    -fno-section-anchors -fno-zero-initialized-in-bss \
    "$temporary/resources.c" -o "$output"
