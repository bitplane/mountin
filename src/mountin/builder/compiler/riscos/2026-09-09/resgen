#!/bin/sh
set -eu

if [ "$#" -ne 4 ] || [ "$3" != "-via" ]; then
    echo "usage: resgen area output -via file" >&2
    exit 2
fi

output=$2
via=$4
case "$output" in
    /*) ;;
    *) output=$PWD/$output ;;
esac
case "$via" in
    /*) ;;
    *) via=$PWD/$via ;;
esac

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
root=$temporary/root
mkdir -p "$root"

while read -r source destination; do
    [ -n "$source" ] || continue
    destination=$(printf '%s' "$destination" | tr . /)
    parent=${destination%/*}
    if [ "$parent" != "$destination" ]; then
        mkdir -p "$root/$parent"
    fi
    cp "$source" "$root/$destination"
done < "$via"

mkresfs -o "$temporary/resources.c" "$root"
sed -i 's/^static const unsigned char payload\[\]/const unsigned char payload[]/' \
    "$temporary/resources.c"
cat >> "$temporary/resources.c" <<'EOF'

void *Resources(void)
{
    return (void *)payload;
}
EOF

arm-unknown-riscos-gcc -c -mmodule -mlibscl -march=armv6 \
    -fno-section-anchors -fno-zero-initialized-in-bss \
    "$temporary/resources.c" -o "$output"
