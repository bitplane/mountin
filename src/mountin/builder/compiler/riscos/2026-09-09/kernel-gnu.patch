+#ifdef __GNUC__
+static inline log2phys_result RISCOS_LogToPhys(const void *log)
+{
+	register uint32_t r0 __asm("r0") = (uint32_t)log;
+	register uint32_t r1 __asm("r1");
+	register uint32_t r2 __asm("r2");
+	register uint32_t r3 __asm("r3");
+	__asm volatile ("bl RISCOS_LogToPhys"
+		: "+r" (r0), "=r" (r1), "=r" (r2), "=r" (r3)
+		:
+		: "r12", "lr", "cc", "memory");
+	return (log2phys_result) { ((uint64_t)r1 << 32) | r0, r2, r3 };
+}
+#else
