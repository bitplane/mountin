+
+U0 AsmPatchStore(CCmpCtrl *cc,U8 *buf,CAsmPatch *patch,I64 value)
+{
+  switch(patch->sz) {
+    break;case 1: buf[patch->rip]=value;
+    break;case 2: buf[patch->rip](U16)=value;
+    break;case 4: buf[patch->rip](U32)=value;
+    break;case 8: buf[patch->rip](U64)=value;
+    default: LexExcept(cc,"Invalid assembler relocation size");
+  }
+}
+
+I64 AsmPatchRelocationType(CCmpCtrl *cc,CAsmPatch *patch)
+{
+  switch(patch->sz) {
+    break;case 1: return patch->is_rel ? IET_REL_I8 : IET_IMM_U8;
+    break;case 2: return patch->is_rel ? IET_REL_I16 : IET_IMM_U16;
+    break;case 4: return patch->is_rel ? IET_REL_I32 : IET_IMM_U32;
+    break;case 8: return patch->is_rel ? IET_REL_I64 : IET_IMM_I64;
+    default: LexExcept(cc,"Invalid AOT assembler relocation size");
+  }
+  return 0;
+}
