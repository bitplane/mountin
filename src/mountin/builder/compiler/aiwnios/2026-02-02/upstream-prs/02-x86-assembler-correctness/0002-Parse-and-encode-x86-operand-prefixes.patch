+  AO("CMPSW",-1,-1,0xa7,-1,X86_OPCF_OPSIZE16);
   AO("CMPSD",-1,-1,0xa7,-1,0);
   AO("CMPSQ",-1,-1,0xa7,-1,X86_OPCF_REXW);
 
