From 96f87999c795f12be3d1561455f39eab3d361086 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 08:48:51 +0100
Subject: [PATCH 2/6] Parse and encode x86 operand prefixes

Carry operand and address widths through instruction selection and prefix
emission. Mark fixed-width instruction forms explicitly so their encoding
uses the requested width in each assembly mode.
---
 Src/AsmX64.HC  | 29 ++++++++++++++++++++++-------
 Src/UAsmX64.HC | 30 +++++++++++++++---------------
 2 files changed, 37 insertions(+), 22 deletions(-)

diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index 6116b1c..cefaffb 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -111,6 +111,20 @@ CX86AddrMode *PrsX86AddrMode(CCmpCtrl *cc) {
   mode->imm=0;
   mode->label=NULL;
 prefix:
+  if(cc->token==TK_IDENT&&cc->hash_entry&&
+        cc->hash_entry->type&HTT_CLASS&&
+        !StrCmp(cc->cur_str,cc->hash_entry->str)) {
+    lookahead=cc->cur_buf_ptr;
+    while(*lookahead&&*lookahead<=' ') lookahead++;
+    tmpc=cc->hash_entry;
+    if(!(tmpc->member_lst_and_root&&
+          (cc->flags&CCF_USE_LAST_U16&&cc->last_U16=='.'||*lookahead=='.'))) {
+      mode->operand_sz=tmpc->size;
+      Lex(cc);
+      if(cc->token!='[')
+        goto size_prefix_consumed;
+    }
+  }
   if(cc->token==TK_IDENT) {
     tmpc=HashFind(cc->cur_str,cmp.asm_hash,HTT_INTERNAL_TYPE);
     if(tmpc) {
@@ -119,8 +133,7 @@ prefix:
       goto size_prefix_consumed;
     }
   }
-  if(cc->token==TK_IDENT||cc->hash_entry&&
-        cc->hash_entry->type&HTT_INTERNAL_TYPE) {
+  if(cc->token==TK_IDENT) {
     lookahead=cc->cur_buf_ptr;
     while(*lookahead&&*lookahead<=' ') lookahead++;
     rg=HashFind(cc->cur_str,cmp.asm_hash,HTT_REG);
@@ -158,6 +171,7 @@ prefix:
       mode->operand_sz=tmpc->size;
       Lex(cc);
     }
+  }
 size_prefix_consumed:
     if(!rg&&cc->token==TK_IDENT)
       rg=HashFind(cc->cur_str,cmp.asm_hash,HTT_REG);
@@ -178,7 +192,6 @@ size_prefix_consumed:
       mode->type=X86MT_REG;
       goto ret;
     }
-  }
 indir:
   if(cc->token=='[') {
     Lex(cc);
@@ -1020,6 +1033,10 @@ rex|=0x40;
     to[len++]=0x66;
   }
 //Prefix group 4(Address size ovveride)
+  if (seg_size==16&&indir_mode ||
+        seg_size==64&&indir_mode&&indir_mode->short_addr==1)
+    to[len++]=0x67;
+
   if(rex&0x40) {
     to[len++]=rex;    
   }
@@ -1352,10 +1369,8 @@ enter:
   cc->flags|=CCF_CLASS_DOL_OFFSET;
   cc->class_dol_offset=len;
   if(cc->token==TK_IDENT) {
-    asm_entry=cc->hash_entry;
-    if(!asm_entry||!(asm_entry->type&(HTT_OPCODE|HTT_ASM_KEYWORD)))
-      asm_entry=HashFind(cc->cur_str,cmp.asm_hash,
-            HTT_OPCODE|HTT_ASM_KEYWORD);
+    asm_entry=HashFind(cc->cur_str,cmp.asm_hash,
+          HTT_OPCODE|HTT_ASM_KEYWORD);
     if(asm_entry) cc->hash_entry=asm_entry;
   }
   MemSetU64(modes,NULL,4);
diff --git a/Src/UAsmX64.HC b/Src/UAsmX64.HC
index 8a61628..2e802df 100644
--- a/Src/UAsmX64.HC
+++ b/Src/UAsmX64.HC
@@ -1110,7 +1110,7 @@ U0 UAsmInit() {
   AO("CALL",-1,-1,0xff,-1,X86_OPCF_MODRM,X86_OPERAND_RMx,X86_OPERAND_EXT,2);
   AO("CALLF",-1,-1,0xff,-1,X86_OPCF_MODRM,X86_OPERAND_RMx,X86_OPERAND_EXT,3);
 
-  AO("CBW",0x66,-1,0x98,-1,0);
+  AO("CBW",-1,-1,0x98,-1,X86_OPCF_OPSIZE16);
   AO("CWDE",-1,-1,0x98,-1,0);
   AO("CDQE",-1,-1,0x98,-1,X86_OPCF_REXW);
 
