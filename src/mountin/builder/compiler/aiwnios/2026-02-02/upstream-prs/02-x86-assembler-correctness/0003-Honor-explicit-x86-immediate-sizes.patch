From bf509211586552252eb67478c562fec2d450a960 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 08:48:51 +0100
Subject: [PATCH 3/6] Honor explicit x86 immediate sizes

Prevent byte-immediate forms from overriding an explicit wider operand.
Keep unresolved expressions out of byte forms until their value is known,
and provide the explicitly sized 16-bit immediate PUSH form.
---
 Src/AsmX64.HC  | 13 +++++++++++++
 Src/UAsmX64.HC |  2 ++
 2 files changed, 15 insertions(+)

diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index cefaffb..04b5d1b 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -383,6 +383,11 @@ r64:
       goto r64;
     case X86_OPERAND_IMM8:
       if(mem_only) return FALSE;
+      if(mode->operand_sz!=-1&&mode->operand_sz!=1)
+        return FALSE;
+      //An unresolved expression cannot be proven to fit a signed byte.
+      if(mode->machine_code)
+        return FALSE;
       if(mode->type==X86MT_IMM)
         if(I8_MIN<=mode->imm<=U8_MAX)
 	  goto pass;
@@ -393,6 +398,12 @@ r64:
         if(I16_MIN<=mode->imm<=U16_MAX)
 	  goto pass;
       return FALSE;
+    case X86_OPERAND_EXPLICIT_IMM16:
+      if(mem_only) return FALSE;
+      if(mode->operand_sz==2&&mode->type==X86MT_IMM)
+        if(I16_MIN<=mode->imm<=U16_MAX)
+	  goto pass;
+      return FALSE;
     case X86_OPERAND_IMM32:
       if(mem_only) return FALSE;
       if(mode->type==X86MT_IMM)
@@ -1094,6 +1105,7 @@ rex|=0x40;
 		    sz=1;
 		    break;
 		  case X86_OPERAND_IMM16:
+		  case X86_OPERAND_EXPLICIT_IMM16:
 		    sz=2;
 		    break;
 		  case X86_OPERAND_IMM32:
@@ -1129,6 +1141,7 @@ rex|=0x40;
 		  to[len++]=modes[a]->imm;
 		  break;
 	        case X86_OPERAND_IMM16:
+	        case X86_OPERAND_EXPLICIT_IMM16:
 		  to[len](I16)=modes[a]->imm;
 		  len+=2;
 		  break;
diff --git a/Src/UAsmX64.HC b/Src/UAsmX64.HC
index 2e802df..525c025 100644
--- a/Src/UAsmX64.HC
+++ b/Src/UAsmX64.HC
@@ -59,6 +59,7 @@
 //TODO,Nroot is not implementeing vector types now.
 #define X86_OPERAND_M128 49
 #define X86_OPERAND_CONST_SREG 50
+#define X86_OPERAND_EXPLICIT_IMM16 51
 
 class CX86Opcode:CHash {
   //-1 for absent
@@ -1765,6 +1766,7 @@ U0 UAsmInit() {
 //  AO("PUNPCKLWD",0x66,0xf,0x61,-1,X86_OPCF_MODRM,X86_OPERAND_RXMM,X86_OPERAND_RMXMM128);
  
   AO("PUSH",-1,-1,0x50,-1,X86_OPCF_ADD_REG,X86_OPERAND_R64);
+  AO("PUSH",-1,-1,0x68,-1,X86_OPCF_OPSIZE16,X86_OPERAND_EXPLICIT_IMM16);
   AO("PUSH",-1,-1,0x68,-1,0,X86_OPERAND_IMM32);
   AO("PUSH",-1,-1,0x6a,-1,0,X86_OPERAND_IMM8);
   AO("PUSH",-1,-1,0xff,-1,X86_OPCF_MODRM,X86_OPERAND_EXT,6,X86_OPERAND_RMx);
-- 
