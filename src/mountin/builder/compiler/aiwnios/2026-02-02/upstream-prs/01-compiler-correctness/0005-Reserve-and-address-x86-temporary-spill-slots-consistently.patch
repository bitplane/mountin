From 3900628d6c53653453db350b04da544d6dc4e8e2 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 13:47:04 +0100
Subject: [PATCH 5/5] Reserve and address x86 temporary spill slots consistently

A zero local-frame size is valid for top-level expressions. Treating it as an unset spill base placed temporaries outside the reserved frame, where subsequent calls could overwrite them. The prologue also omitted small allocations entirely.

Use the frame size established by FuncProlog for all spill offsets, place each slot below that frame, and reserve every nonempty allocation. Cover call comparisons in expressions, branches and short-circuit conditions, including floating-point results, current-PC values and stack locals.
---
 Tests/Compiler/CallCompare.HC | 38 +++++++++++++++++++++++++++++++++++
 Tests/Compiler/CurrentPC.HC   |  3 +++
 c/x86_64_backend.c            | 15 ++------------
 3 files changed, 43 insertions(+), 13 deletions(-)
 create mode 100644 Tests/Compiler/CallCompare.HC

diff --git a/Tests/Compiler/CallCompare.HC b/Tests/Compiler/CallCompare.HC
new file mode 100644
index 0000000..c7c7137
--- /dev/null
+++ b/Tests/Compiler/CallCompare.HC
@@ -0,0 +1,38 @@
+I64 CallValue(I64 value) { return value; }
+F64 CallFloat(F64 value) { return value; }
+
+I64 equal=CallValue(123456)==CallValue(123456);
+I64 unequal=CallValue(123456)!=CallValue(123456);
+if (!equal || unequal)
+  throw('CallCmp');
+if (CallValue(123456)!=CallValue(123456))
+  throw('CallCmp');
+if (CallValue(123456)==CallValue(654321))
+  throw('CallCmp');
+if (CallValue(1)!=CallValue(1) || CallValue(2)!=CallValue(2))
+  throw('CallCmp');
+if (!(CallValue(1)==CallValue(1) && CallValue(2)==CallValue(2)))
+  throw('CallCmp');
+if (CallFloat(1.5)!=CallFloat(1.5))
+  throw('CallCmp');
+if (CallFloat(1.5)==CallFloat(2.5))
+  throw('CallCmp');
+
+U0 CheckCallComparison()
+{
+  I64 frame[2];
+  frame[0]=123456;
+  frame[1]=654321;
+  if (CallValue(frame[0])!=CallValue(frame[0]) ||
+      CallValue(frame[1])!=CallValue(frame[1]))
+    throw('CallCmp');
+  if (CallValue(123456)!=CallValue(123456))
+    throw('CallCmp');
+  if (CallValue(123456)==CallValue(654321))
+    throw('CallCmp');
+  if (frame[0]!=123456 || frame[1]!=654321)
+    throw('CallCmp');
+}
+CheckCallComparison();
+"PASS: CallCompare\n";
+Exit;
diff --git a/Tests/Compiler/CurrentPC.HC b/Tests/Compiler/CurrentPC.HC
index 0f12771..20a8fcf 100644
--- a/Tests/Compiler/CurrentPC.HC
+++ b/Tests/Compiler/CurrentPC.HC
@@ -27,5 +27,8 @@ U8 *direct1=CurrentPCDirect(),*direct2=CurrentPCDirect();
 U8 *stored1=CurrentPCStored(),*stored2=CurrentPCStored();
 if (direct1!=direct2 || stored1!=stored2)
   throw('CurPC');
+if (CurrentPCDirect()!=CurrentPCDirect() ||
+    CurrentPCStored()!=CurrentPCStored())
+  throw('CurPC');
 "PASS: CurrentPC\n";
 Exit;
diff --git a/c/x86_64_backend.c b/c/x86_64_backend.c
index 3ef2cd4..5fcc65c 100644
--- a/c/x86_64_backend.c
+++ b/c/x86_64_backend.c
@@ -2650,18 +2650,7 @@ static void PushSpilledTmp(CCmpCtrl *cctrl, CRPN *rpn) {
       cctrl->backend_user_data0 = res->off;
     }
   }
-  // See two above notes
-  res->off -= 8;
-  // In functions,wiggle room comes after the function locals.
-  if (cctrl->cur_fun && res->mode == MD_FRAME)
-    res->off += cctrl->cur_fun->base.sz + 16; //+16 for LR/FP
-  else if (res->mode == MD_FRAME) {
-    if (cctrl->backend_user_data4) {
-      res->off += cctrl->backend_user_data4; // wiggle room start(if set)
-    } else
-      // Anonymus potatoes like to assume LR/FP pair too.
-      res->off += 16;
-  }
+  res->off += cctrl->backend_user_data4;
 }
 int64_t TmpRegToReg(int64_t r) {
   switch (r) {
@@ -5762,7 +5751,7 @@ static int64_t FuncProlog(CCmpCtrl *cctrl, char *bin, int64_t code_off) {
       flist[i3++] = i;
   AIWNIOS_ADD_CODE(X86PushReg, RBP);
   AIWNIOS_ADD_CODE(X86MovRegReg, RBP, RSP);
-  if (to_push - 16 > 0)
+  if (to_push > 0)
     AIWNIOS_ADD_CODE(X86SubImm32, RSP, to_push);
   off = -old_regs_start;
   for (i = 0; i != i2; i++) {
-- 
