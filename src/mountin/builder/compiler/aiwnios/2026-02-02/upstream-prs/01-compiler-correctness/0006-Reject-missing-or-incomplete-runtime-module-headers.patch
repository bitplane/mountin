From c4f2b36a370d9e5629acb04668b3a15b25354a61 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 22:37:39 +0100
Subject: [PATCH 6/6] Reject missing or incomplete runtime module headers

FileRead returns an allocated empty buffer when HCRT2.BIN is missing.
Load then reads module fields from an allocation with no header.

Reject null buffers and sizes smaller than CBinFile before creating the
code heap. Report the failed runtime load and exit unsuccessfully at the
startup caller. Bootstrap mode can still generate HCRT2.BIN from source.
---
 c/loader.c | 2 ++
 c/main.c   | 7 +++++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/c/loader.c b/c/loader.c
index a2f49a4..dcd2688 100644
--- a/c/loader.c
+++ b/c/loader.c
@@ -406,6 +406,8 @@ char *Load(char *fbuf, int64_t size) {
   int64_t module_align, misalignment;
   CBinFile *bfh;
   CBinFile *bfh_addr;
+  if (!fbuf || size < (int64_t)sizeof(CBinFile))
+    return NULL;
   CHeapCtrl *hc = HeapCtrlInit(NULL, Fs, 1);
   SetWriteNP(0);
   bfh = A_MALLOC(size, hc);
diff --git a/c/main.c b/c/main.c
index 2386c5e..1af70de 100644
--- a/c/main.c
+++ b/c/main.c
@@ -2006,8 +2006,11 @@ static int64_t Boot(int64_t *) {
   } else
     BootAiwnios(NULL);
   glbl_table = Fs->hash_table;
-  if (hcrt)
-    loaded_hcrt = Load(hcrt, hcrt_size);
+  loaded_hcrt = Load(hcrt, hcrt_size);
+  if (!loaded_hcrt) {
+    fprintf(stderr, "HCRT2.BIN is missing or has an incomplete header; run with -b to bootstrap it.\n");
+    exit(EXIT_FAILURE);
+  }
 }
 static int64_t quit = 0, quit_code = 0;
 static void AiwniosBye() {
