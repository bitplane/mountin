diff --git a/Src/CMain.HC b/Src/CMain.HC
index 0cf390e..37d46b7 100644
--- a/Src/CMain.HC
+++ b/Src/CMain.HC
@@ -261,7 +261,7 @@ CAOT *CmpBuf(U8 *buf,U8 *map_name=NULL,
