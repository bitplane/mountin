From dc76fd8517c7a659c887e44750d7e7d13da9212c Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:50 +0100
Subject: [PATCH 36/71] Resolve exact assembly expression imports

---
 Src/AIWNIOS_CodeGen.HC |  2 +-
 Src/AsmResolve.HC      | 27 ++++++++++++++++++++++++++-
 Src/AsmX64.HC          |  3 ++-
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/Src/AIWNIOS_CodeGen.HC b/Src/AIWNIOS_CodeGen.HC
index bfeae0e..6afba68 100644
--- a/Src/AIWNIOS_CodeGen.HC
+++ b/Src/AIWNIOS_CodeGen.HC
@@ -2271,7 +2271,7 @@ break;case IC_RIP:
           h->module_base=machine_code;
           //[reloc type 1][reloc offset 4][target-offset 4][name?]NULL]
           //Nroot adds an aditional byte to specify NULL after we load the silly sauce 
-          h->module_header_entry=CAlloc(StrLen(h->str)+8+1+1);
+          h->module_header_entry=CAlloc(StrLen(h->str)+8+1+1+1);
           if(IsTLSReloc(misc))
 	    h->module_header_entry[0]=IET_IMM_I64;
           else 
diff --git a/Src/AsmResolve.HC b/Src/AsmResolve.HC
index 8781c81..95f6e3a 100644
--- a/Src/AsmResolve.HC
+++ b/Src/AsmResolve.HC
@@ -82,6 +82,30 @@ U0 AsmResolve(CCmpCtrl *cc,CAsmUnresolvedRef *tmpu,U8 *label,Bool undefined)
   }
 }
 
+U0 AsmExpressionImportsResolve(U8 *name,U8 *module_base,I64 value)
+{
+  CHashTable *table=Fs->hash_table;
+  CHashImport *entry;
+  I64 i,rel_off,resolved;
+
+  for (i=0;i<=table->mask;i++) {
+    entry=table->body[i];
+    while (entry) {
+      if (entry->type&HTT_IMPORT_SYS_SYM &&
+            entry->module_base==module_base &&
+            !StrCmp(entry->str,name)) {
+        rel_off=entry->module_header_entry[1](U32);
+        if (rel_off&0x80000000)
+          rel_off-=0x100000000;
+        resolved=value+entry->module_header_entry[5](I32);
+        WriteProtectMemCpy(entry->module_base+rel_off,&resolved,8);
+        entry->type=HTT_INVALID;
+      }
+      entry=entry->next;
+    }
+  }
+}
+
 CHashExport *AOTResolvedAsmExportFind(CCmpCtrl *cc,U8 *name)
 {
   CHashTable *table;
@@ -138,7 +162,8 @@ U0 AOTGlblsResolve(CCmpCtrl *cc,CAOT *tmpaot)
           binding->str=StrNew(tmpex->str);
           binding->val=resolved_export->val;
           HashAdd(binding,Fs->hash_table);
-          SysSymImportsResolve(tmpex->str,0);
+          AsmExpressionImportsResolve(tmpex->str,tmpu->machine_code,
+                resolved_export->val);
           HashRemDel(binding,Fs->hash_table);
 	  label=tmpauh->hash->str;
 	} else {
diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index 8346a7a..46ed46e 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -1376,7 +1376,8 @@ Bool AsmPatchResolveLabels(CCmpCtrl *cc,CAsmPatch *patch,CQue *to_fill)
       exp->val=-member->offset;
     }
     HashAdd(exp,Fs->hash_table);
-    SysSymImportsResolve(cur->hash->str,0);
+    AsmExpressionImportsResolve(cur->hash->str,patch->imm->machine_code,
+          exp->val);
     HashRemDel(exp,Fs->hash_table);
   }
 
