From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:48 +0100
Subject: [PATCH 22/71] Compile assembly expressions as JIT

---
 Src/AsmX64.HC | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index 69dd56e..70fb442 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -68,7 +68,7 @@ Bool PrsAsmImm(CCmpCtrl *cc,CX86AddrMode *arg)
   arg->glbl_asm_undef_hash=NULL;
   cc->asm_undef_hash=NULL;
   cc->abs_cnts=0;
-  cc->flags&=~(CCF_UNRESOLVED+CCF_LOCAL);
+  cc->flags&=~(CCF_UNRESOLVED+CCF_LOCAL+CCF_AOT_COMPILE);
   cc->flags|=CCF_ASM_EXPRESSIONS;
   if (!IsLexExpression2Bin(cc,&arg->machine_code))
     LexSkipEol(cc);
