From c4fbbc5b7c9db0f4bf96bba81deffc7bef04e03a Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:52 +0100
Subject: [PATCH 60/71] Omit tail padding from raw assembly

---
 c/arm_backend.c    | 2 +-
 c/riscv_backend.c  | 2 +-
 c/x86_64_backend.c | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/c/arm_backend.c b/c/arm_backend.c
index 7a344e4..2b03bce 100644
--- a/c/arm_backend.c
+++ b/c/arm_backend.c
@@ -5297,7 +5297,7 @@ char *OptPassFinal(CCmpCtrl *cctrl, int64_t *res_sz, char **dbg_info,
       }
     }
     if (run) {
-      if (code_off % 8) // Align to 8
+      if (!(cctrl->flags & CCF_RAW_AOT_ASM) && code_off % 8) // Align to 8
         code_off += 8 - code_off % 8;
       cctrl->statics_label->addr = code_off + bin;
       for (r = cctrl->code_ctrl->ir_code->next; r != cctrl->code_ctrl->ir_code;
diff --git a/c/riscv_backend.c b/c/riscv_backend.c
index babf29f..8627ac8 100644
--- a/c/riscv_backend.c
+++ b/c/riscv_backend.c
@@ -4880,7 +4880,7 @@ char *OptPassFinal(CCmpCtrl *cctrl, int64_t *res_sz, char **dbg_info,
         goto fill_in_refs;
       }
     }
-    if (code_off % 8) // Align to 8
+    if (!(cctrl->flags & CCF_RAW_AOT_ASM) && code_off % 8) // Align to 8
       code_off += 8 - code_off % 8;
     cctrl->code_ctrl->statics_offset = code_off;
     cctrl->statics_label->addr = bin + cctrl->code_ctrl->statics_offset;
diff --git a/c/x86_64_backend.c b/c/x86_64_backend.c
index b467108..f0a412f 100644
--- a/c/x86_64_backend.c
+++ b/c/x86_64_backend.c
@@ -9222,7 +9222,7 @@ char *OptPassFinal(CCmpCtrl *cctrl, int64_t *res_sz, char **dbg_info,
         goto fill_in_refs;
       }
     }
-    if (code_off % 8) // Align to 8
+    if (!(cctrl->flags & CCF_RAW_AOT_ASM) && code_off % 8) // Align to 8
       code_off += 8 - code_off % 8;
     cctrl->code_ctrl->statics_offset = code_off;
     cctrl->statics_label->addr = bin + cctrl->code_ctrl->statics_offset;
-- 
2.53.0

