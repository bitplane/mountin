From 6f45f1f6a2e5cc727f13bcbcd3531bb8a2bbf16f Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:53 +0100
Subject: [PATCH 71/71] Support ModU64 intrinsic

---
 Src/AIWNIOS_CodeGen.HC   |  5 +++++
 Tests/Compiler/ModU64.HC | 13 +++++++++++++
 c/aiwn_lexparser.h       |  2 ++
 c/main.c                 |  4 ++++
 c/optpass.c              |  2 ++
 c/parser.c               | 16 ++++++++++++++++
 c/x86_64_backend.c       | 35 +++++++++++++++++++++++++++++++++++
 7 files changed, 77 insertions(+)
 create mode 100644 Tests/Compiler/ModU64.HC

diff --git a/Src/AIWNIOS_CodeGen.HC b/Src/AIWNIOS_CodeGen.HC
index d3fe141..ca3ee11 100644
--- a/Src/AIWNIOS_CodeGen.HC
+++ b/Src/AIWNIOS_CodeGen.HC
@@ -117,6 +117,7 @@ import U8 *__HC_ICAdd_QueInsRev(U8*);
 import U8 *__HC_ICAdd_QueRem(U8*);
 import U8 *__HC_ICAdd_InvlPg(U8*);
 import U8 *__HC_ICAdd_StrLen(U8*);
+import U8 *__HC_ICAdd_ModU64(U8*);
 import U8 *__HC_ICAdd_Ret(U8*);
 import U8 *__HC_ICAdd_Arg(U8*,I64);
 import U8 *__HC_ICAdd_SetFrameSize(U8*,I64);
@@ -243,6 +244,7 @@ extern U8 *__HC_ICAdd_QueInsRev(U8*);
 extern U8 *__HC_ICAdd_QueRem(U8*);
 extern U8 *__HC_ICAdd_InvlPg(U8*);
 extern U8 *__HC_ICAdd_StrLen(U8*);
+extern U8 *__HC_ICAdd_ModU64(U8*);
 extern U8 *__HC_ICAdd_Ret(U8*);
 extern U8 *__HC_ICAdd_Arg(U8*,I64);
 extern U8 *__HC_ICAdd_SetFrameSize(U8*,I64);
@@ -2093,6 +2095,8 @@ break;case IC_RIP:
     new=__HC_ICAdd_InvlPg(cc2);
     break;case IC_STRLEN:
     new=__HC_ICAdd_StrLen(cc2);
+    break;case IC_MOD_U64:
+    new=__HC_ICAdd_ModU64(cc2);
 #else
     break;case IC_BSF:
     case IC_BSR:
@@ -2114,6 +2118,7 @@ break;case IC_RIP:
     case IC_QUE_REM:
     case IC_INVLPG:
     case IC_STRLEN:
+    case IC_MOD_U64:
       PrintErr("Intrinsic is not implemented for this target\n");
       throw('Compiler');
 #endif
diff --git a/Tests/Compiler/ModU64.HC b/Tests/Compiler/ModU64.HC
new file mode 100644
index 0000000..9c709b4
--- /dev/null
+++ b/Tests/Compiler/ModU64.HC
@@ -0,0 +1,13 @@
+public _intern IC_MOD_U64 U64 TestMod(U64 *q,U64 d);
+U64 TestDivisor() {return 7;}
+U64 q=100,r;
+r=TestMod(&q,7);
+if (q!=14 || r!=2) throw('ModConst');
+q=100;
+r=TestMod(&q,TestDivisor());
+if (q!=14 || r!=2) throw('ModCall');
+q=U64_MAX;
+r=TestMod(&q,16);
+if (q!=0x0FFFFFFFFFFFFFFF || r!=15) throw('ModWide');
+"PASS: ModU64\n";
+Exit;
diff --git a/c/aiwn_lexparser.h b/c/aiwn_lexparser.h
index d093418..9ef1cc7 100644
--- a/c/aiwn_lexparser.h
+++ b/c/aiwn_lexparser.h
@@ -373,6 +373,7 @@ enum {
   IC_TO_UPPER,
   IC_SQRT,
   IC_SWAP,
+  IC_MOD_U64,
   IC_CNT, // MUST BE THE LAST ITEM
 };
 typedef struct CICArg {
@@ -762,6 +763,7 @@ HC_IC_BINDINGH(HC_ICAdd_ToBool)
 HC_IC_BINDINGH(HC_ICAdd_ToUpper)
 
 CRPN *__HC_ICAdd_Swap(CCodeCtrl *cc, int64_t width);
+CRPN *__HC_ICAdd_ModU64(CCodeCtrl *cc);
 
 CRPN *__HC_ICAdd_FReg(CCodeCtrl *cc, int64_t r);
 CRPN *__HC_ICAdd_IReg(CCodeCtrl *cc, int64_t r, int64_t rt, int64_t ptr_cnt);
diff --git a/c/main.c b/c/main.c
index 04fc1a9..27b7482 100644
--- a/c/main.c
+++ b/c/main.c
@@ -1272,6 +1272,9 @@ static int64_t STK___HC_ICAdd_InvlPg(int64_t *stk) {
 static int64_t STK___HC_ICAdd_StrLen(int64_t *stk) {
   return __HC_ICAdd_StrLen(stk[0]);
 }
+static int64_t STK___HC_ICAdd_ModU64(int64_t *stk) {
+  return __HC_ICAdd_ModU64(stk[0]);
+}
 static int64_t STK___HC_ICAdd_Ret(int64_t *stk) {
   return __HC_ICAdd_Ret(stk[0]);
 }
@@ -1914,6 +1917,7 @@ static void BootAiwnios(char *bootstrap_text) {
     PrsAddSymbol("__HC_ICAdd_QueRem", STK___HC_ICAdd_QueRem, 1);
     PrsAddSymbol("__HC_ICAdd_InvlPg", STK___HC_ICAdd_InvlPg, 1);
     PrsAddSymbol("__HC_ICAdd_StrLen", STK___HC_ICAdd_StrLen, 1);
+    PrsAddSymbol("__HC_ICAdd_ModU64", STK___HC_ICAdd_ModU64, 1);
     PrsAddSymbol("__HC_ICAdd_Ret", STK___HC_ICAdd_Ret, 1);
     PrsAddSymbol("__HC_ICAdd_Arg", STK___HC_ICAdd_Arg, 2);
     PrsAddSymbol("__HC_ICAdd_SetFrameSize", STK___HC_ICAdd_SetFrameSize, 2);
diff --git a/c/optpass.c b/c/optpass.c
index 7f88a36..881ac56 100644
--- a/c/optpass.c
+++ b/c/optpass.c
@@ -650,6 +650,7 @@ loop:
       break;
     case IC_EQ:
     case IC_SWAP:
+    case IC_MOD_U64:
       goto next1;
       break;
     case IC_SUB:
@@ -1134,6 +1135,7 @@ void OptPassRegAlloc(CCmpCtrl *cctrl) {
       break;
     case IC_EQ:
     case IC_SWAP:
+    case IC_MOD_U64:
       continue;
       break;
     case IC_SUB:
diff --git a/c/parser.c b/c/parser.c
index c613e29..711efc4 100644
--- a/c/parser.c
+++ b/c/parser.c
@@ -376,6 +376,7 @@ CRPN *ICFwd(CRPN *rpn) {
   case IC_LBTS:
   case IC_LBTC:
   case IC_SWAP:
+  case IC_MOD_U64:
   case IC_EQ:
     goto binop;
     break;
@@ -880,6 +881,10 @@ CRPN *ParserDumpIR(CRPN *rpn, int64_t indent) {
     printf("SWAP");
     goto binop;
     break;
+  case IC_MOD_U64:
+    printf("MOD_U64");
+    goto binop;
+    break;
   case IC_EQ:
     printf("=");
     goto binop;
@@ -1445,6 +1450,10 @@ int64_t DolDocDumpIR(char *to, int64_t len, CRPN *rpn) {
     len = AddBytes(to, len, "$PURPLE$SWAP$FD$\n");
     goto binop;
     break;
+  case IC_MOD_U64:
+    len = AddBytes(to, len, "$PURPLE$MOD_U64$FD$\n");
+    goto binop;
+    break;
   case IC_EQ:
     len = AddBytes(to, len, "$PURPLE$=$FD$\n");
     goto binop;
@@ -3551,6 +3560,12 @@ int64_t AssignRawTypeToNode(CCmpCtrl *ccmp, CRPN *rpn) {
     AssignRawTypeToNode(ccmp, ICArgN(rpn, 1));
     return rpn->raw_type = RT_U0;
     break;
+  case IC_MOD_U64:
+    AssignRawTypeToNode(ccmp, ICArgN(rpn, 0));
+    AssignRawTypeToNode(ccmp, ICArgN(rpn, 1));
+    rpn->ic_class = HashFind("U64i", Fs->hash_table, HTT_CLASS, 1);
+    return rpn->raw_type = RT_U64i;
+    break;
   case IC_SQRT:
     AssignRawTypeToNode(ccmp, ICArgN(rpn, 0));
     rpn->ic_class = HashFind("F64", Fs->hash_table, HTT_CLASS, 1);
@@ -4832,6 +4847,7 @@ CRPN *__HC_ICAdd_Swap(CCodeCtrl *cc, int64_t width) {
   QueIns(rpn, cc->ir_code);
   return rpn;
 }
+HC_IC_BINDING(HC_ICAdd_ModU64, IC_MOD_U64);
 
 CRPN *__HC_ICAdd_SetFrameSize(CCodeCtrl *cc, int64_t arg) {
   CRPN *rpn;
diff --git a/c/x86_64_backend.c b/c/x86_64_backend.c
index 44a2996..3ef2cd4 100644
--- a/c/x86_64_backend.c
+++ b/c/x86_64_backend.c
@@ -2323,6 +2323,7 @@ static int64_t SpillsTmpRegs(CRPN *rpn) {
     goto binop;
     break;
   case IC_SWAP:
+  case IC_MOD_U64:
     goto binop;
     break;
   case IC_EQ:
@@ -3191,6 +3192,7 @@ static int64_t PushTmpDepthFirst(CCmpCtrl *cctrl, CRPN *r, int64_t spilled) {
     goto fin;
     break;
   case IC_SWAP:
+  case IC_MOD_U64:
     goto binop;
     break;
   case IC_SUB:
@@ -6349,6 +6351,7 @@ static void SetKeepTmps(CRPN *rpn) {
     break;
   case IC_EQ:
   case IC_SWAP:
+  case IC_MOD_U64:
   case IC_ADD_EQ:
   case IC_SUB_EQ:
   case IC_MUL_EQ:
@@ -6419,6 +6422,7 @@ int64_t __OptPassFinal(CCmpCtrl *cctrl, CRPN *rpn, char *bin,
       [IC_GOTO_IF] = &&ic_goto_if,
       [IC_TO_BOOL] = &&ic_to_bool,
       [IC_SWAP] = &&ic_swap,
+      [IC_MOD_U64] = &&ic_mod_u64,
       [IC_TO_UPPER] = &&ic_to_upper,
       [IC_TO_I64] = &&ic_to_i64,
       [IC_TO_F64] = &&ic_to_f64,
@@ -8954,6 +8958,37 @@ int64_t __OptPassFinal(CCmpCtrl *cctrl, CRPN *rpn, char *bin,
   ic_set_static_data:
     // TODO later
     break;
+  ic_mod_u64:
+    next = ICArgN(rpn, 1);
+    next2 = ICArgN(rpn, 0);
+    next->res.keep_in_tmp = 1;
+    next2->res.keep_in_tmp = 1;
+    code_off = __OptPassFinal(cctrl, next, bin, code_off);
+    tmp = next->res;
+    code_off = PutICArgIntoReg(cctrl, &tmp, RT_PTR, R8, bin, code_off);
+    AIWNIOS_ADD_CODE(X86PushReg, MIR(cctrl, tmp.reg));
+    code_off = __OptPassFinal(cctrl, next2, bin, code_off);
+    tmp = next2->res;
+    code_off = PutICArgIntoReg(cctrl, &tmp, RT_U64i, RCX, bin, code_off);
+    AIWNIOS_ADD_CODE(X86PushReg, MIR(cctrl, tmp.reg));
+    AIWNIOS_ADD_CODE(X86PopReg, MIR(cctrl, RCX));
+    AIWNIOS_ADD_CODE(X86PopReg, MIR(cctrl, R8));
+    AIWNIOS_ADD_CODE(X86MovRegIndirI64, MIR(cctrl, RAX), -1, -1,
+                     MIR(cctrl, R8), 0);
+    AIWNIOS_ADD_CODE(X86XorReg, MIR(cctrl, RDX), RDX);
+    AIWNIOS_ADD_CODE(X86DivReg, MIR(cctrl, RCX));
+    AIWNIOS_ADD_CODE(X86MovIndirRegI64, MIR(cctrl, RAX), -1, -1,
+                     MIR(cctrl, R8), 0);
+    tmp.mode = MD_REG;
+    tmp.raw_type = RT_U64i;
+    tmp.reg = RDX;
+    rpn->tmp_res = tmp;
+    if (rpn->res.keep_in_tmp) {
+      rpn->res = tmp;
+      rpn->res.keep_in_tmp = 1;
+    }
+    code_off = ICMov(cctrl, &rpn->res, &tmp, bin, code_off);
+    break;
   ic_swap:
     next = ICArgN(rpn, 1);
     next2 = ICArgN(rpn, 0);
