From 1cbaef4ed913702fd684b453dc4cb3ed46871985 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 16:57:04 +0100
Subject: [PATCH 1/7] Keep pathname and open-file size interfaces distinct

Reserve FSize for CFile handles and VFsFSize for host paths. Remove the conflicting host alias and obsolete declarations together, and compare the two size interfaces on an existing file.
---
 Src/KernelA.HH             |  2 --
 Tests/Compiler/FileSize.HC | 10 ++++++++++
 c/main.c                   |  1 -
 3 files changed, 10 insertions(+), 3 deletions(-)
 create mode 100644 Tests/Compiler/FileSize.HC

diff --git a/Src/KernelA.HH b/Src/KernelA.HH
index 60e692c..1163132 100644
--- a/Src/KernelA.HH
+++ b/Src/KernelA.HH
@@ -3976,7 +3976,6 @@ import U8i *VFsDirMk(U8i*);
 import U8i *VFsFWrite(U8i*,U8i*,I64i);
 import Bool VFsDel(U8i*);
 import U8i **VFsDir();
-import I64 FSize(U8*);
 import I64 FUnixTime(U8*);
 import U0 VFsFTrunc(U8*,I64);
 import F64 Sqrt(F64);
@@ -4123,7 +4122,6 @@ extern U8i *VFsDirMk(U8i*);
 extern U8i *VFsFWrite(U8i*,U8i*,I64i);
 extern Bool VFsDel(U8i*);
 extern U8i **VFsDir();
-extern I64 FSize(U8*);
 extern I64 FUnixTime(U8*);
 extern U0 VFsFTrunc(U8*,I64);
 extern F64 Sqrt(F64);
diff --git a/Tests/Compiler/FileSize.HC b/Tests/Compiler/FileSize.HC
new file mode 100644
index 0000000..410305b
--- /dev/null
+++ b/Tests/Compiler/FileSize.HC
@@ -0,0 +1,10 @@
+U8 *name="/Src/KernelA.HH";
+CFile *file=FOpen(name,"r");
+if (!file)
+  throw('FileSize');
+I64 size=FSize(file);
+FClose(file);
+if (size<=0 || size!=VFsFSize(name) || FSize(NULL)!=0)
+  throw('FileSize');
+"PASS: FileSize\n";
+Exit;
diff --git a/c/main.c b/c/main.c
index 129f3fc..86a6841 100644
--- a/c/main.c
+++ b/c/main.c
@@ -1838,7 +1838,6 @@ static void BootAiwnios(char *bootstrap_text) {
     PrsAddSymbol("VFsSetDrv", STK_VFsSetDrv, 1);
     PrsAddSymbol("VFsDriveMounted", STK_VFsDriveMounted, 1);
     PrsAddSymbol("FUnixTime", STK_VFsUnixTime, 1);
-    PrsAddSymbol("FSize", STK_VFsFSize, 1);
     PrsAddSymbol("VFsFTrunc", STK_VFsTrunc, 2);
     PrsAddSymbol("UnixNow", STK_UnixNow, 0);
     PrsAddSymbol("__GrPaletteColorSet", STK_GrPaletteColorSet, 2);
-- 
