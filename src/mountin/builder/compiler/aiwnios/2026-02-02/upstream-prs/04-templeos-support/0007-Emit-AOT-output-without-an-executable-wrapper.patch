From f95682f877ec73185ad6c0ea637a0bde783c7a46 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:47 +0100
Subject: [PATCH 07/71] Emit AOT output without an executable wrapper

---
 Src/AIWNIOS_CodeGen.HC | 3 +++
 Src/CMain.HC           | 2 ++
 Src/KernelA.HH         | 1 +
 c/aiwn_lexparser.h     | 2 ++
 c/arm_backend.c        | 6 ++++--
 c/main.c               | 6 ++++++
 c/parser.c             | 4 ++++
 c/riscv_backend.c      | 6 ++++--
 c/x86_64_backend.c     | 6 ++++--
 9 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/Src/AIWNIOS_CodeGen.HC b/Src/AIWNIOS_CodeGen.HC
index bf5d14e..117a195 100644
--- a/Src/AIWNIOS_CodeGen.HC
+++ b/Src/AIWNIOS_CodeGen.HC
@@ -4,6 +4,7 @@
 //  your backend again when you port to another arch
 //
 #ifdef IMPORT_AIWNIOS_SYMS
+import U0 __HC_CmpCtrl_SetRawAOTAsm(U8 *);
 import U0 __HC_SetAOTRelocBeforeRIP(U8 *,I64); //See aiwn.h(TAKES number of bytes before current RIP the symbol is located at)
 import U8 *__HC_CmpCtrlDel(U8 *);
 import U8 *__HC_ICAdd_Sqr(U8 *);
@@ -1407,6 +1408,8 @@ skip_convert:;
   #endif
   if(cc->flags&CCF_AOT_COMPILE)
     __HC_CmpCtrl_SetAOT(acc);
+  if(cc->flags&CCF_RAW_AOT_ASM)
+    __HC_CmpCtrl_SetRawAOTAsm(acc);
   if(info) {
     idx=cc->max_line-cc->min_line;
     *info=MAlloc((idx+2)*8+sizeof(CDbgInfo));
diff --git a/Src/CMain.HC b/Src/CMain.HC
index 065d87b..6f3d168 100644
--- a/Src/CMain.HC
+++ b/Src/CMain.HC
@@ -233,6 +233,8 @@ CAOT *CmpBuf(U8 *buf,U8 *map_name=NULL,
   CCmpCtrl *cc;
   CAOT *res=NULL;
   cc=CmpCtrlNew(buf,CCF_DONT_FREE_BUF);
+  if (GetOption(OPTf_RAW_AOT))
+    Bts(&cc->opts,OPTf_RAW_AOT);
   cc->flags|=CCF_AOT_COMPILE;
   #ifdef TARGET_AARCH64
   //For MacOS RWX protections. 
diff --git a/Src/KernelA.HH b/Src/KernelA.HH
index a1383d4..f69406c 100644
--- a/Src/KernelA.HH
+++ b/Src/KernelA.HH
@@ -1530,6 +1530,7 @@ public class CAutoCompleteDictGlbls
 #define OPTf_KEEP_RELOCATIONS 0x26 //Added by nroot,will keep the CHashImport's
 #define OPTf_BOUNDS_CHECK 0x27 //Added by nroot,Bounds checker
 #define OPTf_BYTE_CODE 0x28 //Added by nroot
+#define OPTf_RAW_AOT 0x29
 
 #define OPTF_ECHO		(1<<OPTf_ECHO)
 
diff --git a/c/aiwn_lexparser.h b/c/aiwn_lexparser.h
index 75013d2..0854a0f 100644
--- a/c/aiwn_lexparser.h
+++ b/c/aiwn_lexparser.h
@@ -185,6 +185,7 @@ typedef struct CCmpCtrl {
 #define CCF_STRINGS_ON_HEAP          0x2
 #define CCF_AOT_COMPILE              0x4
 #define CCF_ICMOV_NO_USE_RAX         0x8
+#define CCF_RAW_AOT_ASM              0x10
   int64_t flags;
   CHashFun *cur_fun;
   CCodeCtrl *code_ctrl;
@@ -764,6 +765,7 @@ extern void *GenFFIBindingNaked(void *fptr, int64_t arity);
 extern void PrsBindCSymbolNaked(char *name, void *ptr, int64_t arity);
 extern void PrsBindCSymbol(char *name, void *ptr, int64_t arity);
 void __HC_CmpCtrl_SetAOT(CCmpCtrl *cc);
+void __HC_CmpCtrl_SetRawAOTAsm(CCmpCtrl *cc);
 
 CRPN *__HC_ICAdd_GetVargsPtr(CCodeCtrl *cc);
 
diff --git a/c/arm_backend.c b/c/arm_backend.c
index 9fdc06c..abaefe7 100644
--- a/c/arm_backend.c
+++ b/c/arm_backend.c
@@ -5161,7 +5161,8 @@ char *OptPassFinal(CCmpCtrl *cctrl, int64_t *res_sz, char **dbg_info,
           obin); // For OpenBSD sexy mapping(see mem.c or ask nroot)
       code_off = 0;
     }
-    code_off = FuncProlog(cctrl, bin, code_off);
+    if (!(cctrl->flags & CCF_RAW_AOT_ASM))
+      code_off = FuncProlog(cctrl, bin, code_off);
     for (cnt = 0; cnt < cnt2; cnt++) {
     enter:
       cctrl->backend_user_data1 = 0;
@@ -5181,7 +5182,8 @@ char *OptPassFinal(CCmpCtrl *cctrl, int64_t *res_sz, char **dbg_info,
       }
     }
     cctrl->epilog_label->addr = code_off + bin;
-    code_off = FuncEpilog(cctrl, bin, code_off);
+    if (!(cctrl->flags & CCF_RAW_AOT_ASM))
+      code_off = FuncEpilog(cctrl, bin, code_off);
     for (misc = cctrl->code_ctrl->code_misc->next;
          misc != cctrl->code_ctrl->code_misc; misc = misc->base.next) {
       switch (misc->type) {
diff --git a/c/main.c b/c/main.c
index 6a0c8a3..9c8687e 100644
--- a/c/main.c
+++ b/c/main.c
@@ -918,6 +918,11 @@ static int64_t STK___HC_CmpCtrl_SetAOT(int64_t *stk) {
   __HC_CmpCtrl_SetAOT((CCmpCtrl *)stk[0]);
 }
 
+static int64_t STK___HC_CmpCtrl_SetRawAOTAsm(int64_t *stk) {
+  __HC_CmpCtrl_SetRawAOTAsm((CCmpCtrl *)stk[0]);
+  return 0;
+}
+
 static int64_t STK__HC_ICAdd_RawBytes(int64_t *stk) {
   return (int64_t)__HC_ICAdd_RawBytes((CCmpCtrl *)stk[0], (char *)stk[1],
                                       stk[2]);
@@ -1725,6 +1730,7 @@ static void BootAiwnios(char *bootstrap_text) {
     PrsAddSymbol("__HC_ICAdd_GetVargsPtr", STK___HC_ICAdd_GetVargsPtr, 1);
     PrsAddSymbol("IsValidPtr", STK_IsValidPtr, 1);
     PrsAddSymbol("__HC_CmpCtrl_SetAOT", STK___HC_CmpCtrl_SetAOT, 1);
+    PrsAddSymbol("__HC_CmpCtrl_SetRawAOTAsm", STK___HC_CmpCtrl_SetRawAOTAsm, 1);
     PrsAddSymbol("__HC_ICAdd_Typecast", STK___HC_ICAdd_Typecast, 3);
     PrsAddSymbol("__HC_ICAdd_SubCall", STK___HC_ICAdd_SubCall, 2);
     PrsAddSymbol("__HC_ICAdd_SubProlog", STK___HC_ICAdd_SubProlog, 1);
diff --git a/c/parser.c b/c/parser.c
index 9acea7e..1454873 100644
--- a/c/parser.c
+++ b/c/parser.c
@@ -5082,6 +5082,10 @@ CRPN *__HC_ICAdd_StaticRef(CCodeCtrl *cc, int64_t off, int64_t rt,
 void __HC_CmpCtrl_SetAOT(CCmpCtrl *cc) {
   cc->flags |= CCF_AOT_COMPILE;
 }
+
+void __HC_CmpCtrl_SetRawAOTAsm(CCmpCtrl *cc) {
+  cc->flags |= CCF_RAW_AOT_ASM;
+}
 HC_IC_BINDING(HC_ICAdd_ToBool, IC_TO_BOOL);
 HC_IC_BINDING(HC_ICAdd_BT, IC_BT);
 HC_IC_BINDING(HC_ICAdd_BTC, IC_BTC);
diff --git a/c/riscv_backend.c b/c/riscv_backend.c
index 9d45e33..bbdcc79 100644
