From b9bb4d5f5196fe59b9d61fc6bb07e4969b03b586 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:51 +0100
Subject: [PATCH 55/71] Reject x86 intrinsics on other targets

---
 Src/AIWNIOS_CodeGen.HC | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/Src/AIWNIOS_CodeGen.HC b/Src/AIWNIOS_CodeGen.HC
index 4ea9cc8..d2cca36 100644
--- a/Src/AIWNIOS_CodeGen.HC
+++ b/Src/AIWNIOS_CodeGen.HC
@@ -2030,6 +2030,7 @@ break;case IC_RIP:
     new=__HC_ICAdd_LNot(cc2);
     break;case IC_UNARY_MINUS:
     new=__HC_ICAdd_Neg(cc2);
+#ifdef TARGET_X86
     break;case IC_BSF:
     new=__HC_ICAdd_Bsf(cc2);
     break;case IC_BSR:
@@ -2070,6 +2071,30 @@ break;case IC_RIP:
     new=__HC_ICAdd_InvlPg(cc2);
     break;case IC_STRLEN:
     new=__HC_ICAdd_StrLen(cc2);
+#else
+    break;case IC_BSF:
+    case IC_BSR:
+    case IC_RDTSC:
+    case IC_GET_RFLAGS:
+    case IC_SET_RFLAGS:
+    case IC_SET_RAX:
+    case IC_SET_RBP:
+    case IC_SET_RSP:
+    case IC_IN_U8:
+    case IC_IN_U16:
+    case IC_IN_U32:
+    case IC_OUT_U8:
+    case IC_OUT_U16:
+    case IC_OUT_U32:
+    case IC_QUE_INIT:
+    case IC_QUE_INS:
+    case IC_QUE_INS_REV:
+    case IC_QUE_REM:
+    case IC_INVLPG:
+    case IC_STRLEN:
+      PrintErr("Intrinsic is not implemented for this target\n");
+      throw('Compiler');
+#endif
     break;case IC_SQRT:
     new=__HC_ICAdd_Sqrt(cc2);
     break;case IC_DEREF:
-- 
2.53.0

