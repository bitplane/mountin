From c548ff7dfc0e5f96d07f479b1c647eebb411706c Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:49 +0100
Subject: [PATCH 33/71] Relocate AOT function references

---
 Src/CMain.HC | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/Src/CMain.HC b/Src/CMain.HC
index 56775f6..5504197 100644
--- a/Src/CMain.HC
+++ b/Src/CMain.HC
@@ -568,9 +568,9 @@ U0 FillInShortCalls(CCmpCtrl *cc) {
   for(tmpaotie=cc->aot->next_ie;tmpaotie!=&cc->aot->next_ie;tmpaotie=tmpaotie1) {
     tmpaotie1=tmpaotie->next;
     if(tmpaotie->short_jmp) {		  
-      fun=HashSingleTableFind(tmpaotie->str,cc->htc.glbl_hash_table,HTT_FUN|HTT_GLBL_VAR);
+      fun=AOTResolvedHashFind(cc,tmpaotie->str);
       if(fun&&fun->type&HTT_FUN) {
-		if(fun->type&HTF_RESOLVE) {
+		if (fun->type&HTF_RESOLVE) {
 		  #ifdef TARGET_RISCV
 		  ptr=fun->exe_addr+tmpaotie->offset;
 riscv_patch:
@@ -624,6 +624,16 @@ riscv_patch:
 			Free(tmpaotie->str);
 			Free(tmpaotie);
 skip:;
+      } else if (fun && fun->type&HTT_EXPORT_SYS_SYM &&
+            fun->type&HTF_RESOLVE) {
+#ifdef TARGET_X86
+        i=fun(CHashExport*)->val-(tmpaotie->rip+4)+tmpaotie->offset;
+        AOTStoreCodeU8At(cc,tmpaotie->rip,
+              i.u8[0],i.u8[1],i.u8[2],i.u8[3]);
+        QueRem(tmpaotie);
+        Free(tmpaotie->str);
+        Free(tmpaotie);
+#endif
       }
     }
   }
-- 
