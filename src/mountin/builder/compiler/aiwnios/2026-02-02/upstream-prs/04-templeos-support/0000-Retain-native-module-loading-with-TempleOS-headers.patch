From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Subject: [PATCH] Retain native module loading with TempleOS headers

The TempleOS source headers redefine BIN_SIGNATURE_VAL while building the
guest. The running Aiwnios compiler must still load its native modules.
Accept that target's native signature as well as the active header's
signature; preserve the OpenBSD x86 distinction.

---
diff --git a/Src/KLoadARM.HC b/Src/KLoadARM.HC
--- a/Src/KLoadARM.HC
+++ b/Src/KLoadARM.HC
@@ -199,6 +199,27 @@
   }
 }
 
+Bool BinSignatureValid(U32 signature)
+{
+  if (signature==BIN_SIGNATURE_VAL)
+    return TRUE;
+#ifdef TARGET_BYTECODE
+  return signature=='BYTC';
+#endif
+#ifdef TARGET_X86
+  if (HOST_ABI=='OpenBSD')
+    return signature=='OX86';
+  return signature=='X86';
+#endif
+#ifdef TARGET_AARCH64
+  return signature=='ARM';
+#endif
+#ifdef TARGET_RISCV
+  return signature=='RV64';
+#endif
+  return FALSE;
+}
+
 U0 LoadPass2(U8 *src,U8 *module_base,I64)
 {
   U8 *st_ptr;
@@ -250,7 +271,7 @@
 
   //See $$LK,"Patch Table Generation",A="FF:::/Compiler/CMain.HC,IET_ABS_ADDR"$$
   module_align=1<<bfh->module_align_bits;
-  if (!module_align || bfh->bin_signature!=BIN_SIGNATURE_VAL) {
+  if (!module_align || !BinSignatureValid(bfh->bin_signature)) {
     Free(bfh);
     Free(fbuf);
     throw('BinModul');
-- 
2.53.0
