From 8d6ff7bcc7ac176bd6f7934df34711087f268dba Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:46 +0100
Subject: [PATCH 01/71] Avoid FSize symbol collision

Reserve FSize for the CFile interface. Host pathname size queries already
use VFsFSize; remove the duplicate binding and both obsolete declarations.

---
 c/main.c | 1 -
 Src/KernelA.HH | 2 --
 Tests/Compiler/FileSize.HC | 10 ++++++++++
 3 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/c/main.c b/c/main.c
index 481eaf3..6a0c8a3 100644
--- a/c/main.c
+++ b/c/main.c
@@ -1833,7 +1833,6 @@ static void BootAiwnios(char *bootstrap_text) {
     PrsAddSymbol("VFsFSeek", STK_VFsFSeek, 2);
     PrsAddSymbol("VFsSetDrv", STK_VFsSetDrv, 1);
     PrsAddSymbol("FUnixTime", STK_VFsUnixTime, 1);
-    PrsAddSymbol("FSize", STK_VFsFSize, 1);
     PrsAddSymbol("VFsFTrunc", STK_VFsTrunc, 2);
     PrsAddSymbol("UnixNow", STK_UnixNow, 0);
     PrsAddSymbol("__GrPaletteColorSet", STK_GrPaletteColorSet, 2);
diff --git a/Src/KernelA.HH b/Src/KernelA.HH
--- a/Src/KernelA.HH
+++ b/Src/KernelA.HH
@@ -3978,7 +3978,6 @@
 import U8i *VFsFWrite(U8i*,U8i*,I64i);
 import Bool VFsDel(U8i*);
 import U8i **VFsDir();
-import I64 FSize(U8*);
 import I64 FUnixTime(U8*);
 import U0 VFsFTrunc(U8*,I64);
 import F64 Sqrt(F64);
@@ -4124,7 +4123,6 @@
 extern U8i *VFsFWrite(U8i*,U8i*,I64i);
 extern Bool VFsDel(U8i*);
 extern U8i **VFsDir();
-extern I64 FSize(U8*);
 extern I64 FUnixTime(U8*);
 extern U0 VFsFTrunc(U8*,I64);
 extern F64 Sqrt(F64);
diff --git a/Tests/Compiler/FileSize.HC b/Tests/Compiler/FileSize.HC
new file mode 100644
--- /dev/null
+++ b/Tests/Compiler/FileSize.HC
@@ -0,0 +1,10 @@
+U8 *name="/Src/KernelA.HH";
+CFile *file=FOpen(name,"r");
+if (!file)
+  throw('FileSize');
+I64 size=FSize(file);
+FClose(file);
+if (size<=0 || size!=VFsFSize(name) || FSize(NULL)!=0)
+  throw('FileSize');
+"PASS: FileSize\n";
+Exit;
-- 
