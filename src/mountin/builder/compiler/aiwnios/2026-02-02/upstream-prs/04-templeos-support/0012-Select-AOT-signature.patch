From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:48 +0100
Subject: [PATCH 12/71] Select AOT signature

---
 Src/CMain.HC   | 2 ++
 Src/KernelA.HH | 1 +
 2 files changed, 3 insertions(+)

diff --git a/Src/CMain.HC b/Src/CMain.HC
index 37d46b7..56775f6 100644
--- a/Src/CMain.HC
+++ b/Src/CMain.HC
@@ -412,6 +412,8 @@ I64 Cmp(U8 *filename,U8 *map_name=NULL,U8 *out_name=NULL,U8 mapfile_drv_let=0,I6
 #ifdef TARGET_RISCV
     bfh->bin_signature='RV64';
 #endif
+    if (Bt(&opts,OPTf_TEMPLEOS_BIN_SIGNATURE))
+      bfh->bin_signature=BIN_SIGNATURE_VAL;
     MemCpy(bfh(U8 *)+sizeof(CBinFile),tmpaot->buf,aot_U8s);
     MemCpy(bfh(U8 *)+sizeof(CBinFile)+aot_U8s,patch_table,
 	  size-aot_U8s-sizeof(CBinFile));
diff --git a/Src/KernelA.HH b/Src/KernelA.HH
index 93ddf49..ca693a4 100644
--- a/Src/KernelA.HH
+++ b/Src/KernelA.HH
@@ -1530,6 +1530,7 @@ public class CAutoCompleteDictGlbls
 #define OPTf_KEEP_RELOCATIONS 0x26 //Added by nroot,will keep the CHashImport's
 #define OPTf_BOUNDS_CHECK 0x27 //Added by nroot,Bounds checker
 #define OPTf_BYTE_CODE 0x28 //Added by nroot
+#define OPTf_TEMPLEOS_BIN_SIGNATURE 0x2A
 #define OPTf_RAW_AOT 0x29
 
 #define OPTF_ECHO		(1<<OPTf_ECHO)
