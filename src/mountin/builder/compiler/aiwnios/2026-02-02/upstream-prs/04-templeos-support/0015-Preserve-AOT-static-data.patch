From c638fa2cb68583e395ab5892841acdc9f088d7ee Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:48 +0100
Subject: [PATCH 15/71] Preserve AOT static data

---
 Src/AIWNIOS_CodeGen.HC | 2 ++
 Src/PrsVar.HC          | 2 --
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Src/AIWNIOS_CodeGen.HC b/Src/AIWNIOS_CodeGen.HC
index 117a195..f4b4824 100644
--- a/Src/AIWNIOS_CodeGen.HC
+++ b/Src/AIWNIOS_CodeGen.HC
@@ -2188,6 +2188,8 @@ break;case IC_RIP:
 			   if(mlst->flags&MLF_STATIC) {
 				 if(mlst->static_data) {
 					MemCpy(tmpgh->data+mlst->offset,mlst->static_data,mlst->member_class->size*mlst->dim.total_cnt);
+					Free(mlst->static_data);
+					mlst->static_data=NULL;
 				 }
 			   }
 			   mlst=mlst->next;
diff --git a/Src/PrsVar.HC b/Src/PrsVar.HC
index 7893867..0615044 100644
--- a/Src/PrsVar.HC
+++ b/Src/PrsVar.HC
@@ -598,8 +598,6 @@ pvl_restart3:
 	    tmpm->use_cnt=0;
 	    cc->flags|=CCF_DONT_MAKE_RES;
 	  }
-	  if (cc->flags&CCF_AOT_COMPILE)
-	    Free(tmpm->static_data);
 	  break;
 	case PRS1B_LOCAL_VAR:
 	  if (mode&PRSF_UNION) {
-- 
2.53.0

