From 318293f1ba1cfc0897b4921d75124a0e2a87541b Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:47 +0100
Subject: [PATCH 04/71] Call assembly immediates

---
 Src/AsmX64.HC | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index c51b6a5..0b9fcc7 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -63,6 +63,7 @@ class CAsmPatch:CQue  {
 Bool PrsAsmImm(CCmpCtrl *cc,CX86AddrMode *arg)
 {
   I64 old_flags=cc->flags;
+  I64 (*machine_code)();
   arg->local_asm_undef_hash=NULL;
   arg->glbl_asm_undef_hash=NULL;
   cc->asm_undef_hash=NULL;
@@ -83,7 +84,8 @@ Bool PrsAsmImm(CCmpCtrl *cc,CX86AddrMode *arg)
 	cc->asm_undef_hash=NULL;
       }
     } else {
-      arg->imm=(*arg->machine_code)();
+      machine_code=arg->machine_code;
+      arg->imm=(*machine_code)();
       arg->glbl_asm_undef_hash=cc->asm_undef_hash;
       cc->asm_undef_hash=NULL;
       Free(arg->machine_code);
