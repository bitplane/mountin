From 2cad9eb01abf546cf60ddd6e7da2b05539f2aa63 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:50 +0100
Subject: [PATCH 37/71] Write resolved AOT assembly data

---
 Src/AsmX64.HC | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index 46ed46e..5e2f6d9 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -1446,6 +1446,21 @@ U0 JITFixupAiwniosAOTBlob(CCmpCtrl *cc,CAiwniosAOTBlob *blob,U8 *buf) {
           patch->imm->local_asm_undef_hash=NULL;
           patch->imm->glbl_asm_undef_hash=NULL;
         }
+      } else if(patch->imm&&(patch->sz==1||patch->sz==2||
+            patch->sz==4||patch->sz==8)) {
+        tmp=patch->imm->off;
+        if(patch->is_rel)
+          tmp-=blob->final_start_rip+patch->rip+patch->sz;
+        if(patch->sz==1)
+          buf[patch->rip]=tmp;
+        else if(patch->sz==2)
+          buf[patch->rip](U16)=tmp;
+        else if(patch->sz==4)
+          buf[patch->rip](U32)=tmp;
+        else
+          buf[patch->rip](U64)=tmp;
+        X86AddrModeDel(patch->imm);
+        patch->imm=NULL;
       }
       patch=next_patch;
     }
-- 
