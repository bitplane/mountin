From 8a0cd1efd0f99ca3dc01a681ed887f72273d8e05 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:48 +0100
Subject: [PATCH 18/71] Classify AOT constant expressions

---
 Src/AIWNIOS_PrsExp.HC | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Src/AIWNIOS_PrsExp.HC b/Src/AIWNIOS_PrsExp.HC
index fe0bee9..ce2283f 100644
--- a/Src/AIWNIOS_PrsExp.HC
+++ b/Src/AIWNIOS_PrsExp.HC
@@ -1845,11 +1845,18 @@ U8 *LexExpression2Bin(CCmpCtrl *cc,I64 *_type=NULL)
 {//Compile cc expression. You call the code.
   U8 *res;
   I64 size;
+  CRPN *rpn;
   CHashFun *old_fun;
   Bool old_trace=LBtr(&cc->flags,CCf_PASS_TRACE_PRESENT);
   COCPush(cc);
   COCInit(cc);
   if (PrsExpression(cc,NULL,PEF_NO_COMMA)) {
+    if (Bt(&cc->opts,OPTf_TEMPLEOS_BIN_SIGNATURE))
+      for (rpn=cc->coc.coc_head.next;rpn!=&cc->coc.coc_head;rpn=rpn->next)
+        if (intermediate_code_table[rpn->type].not_const) {
+          cc->flags|=CCF_NOT_CONST;
+          break;
+        }
     RPNAddNew(cc,IC_RET,0,AssignRawTypeToNode(cc->coc.coc_head.next),FALSE);
     old_fun=cc->htc.fun; //Changed by nroot
     cc->htc.fun=NULL;
