diff --git a/Tests/Compiler/ModU64.HC b/Tests/Compiler/ModU64.HC
new file mode 100644
index 0000000..9c709b4
--- /dev/null
+++ b/Tests/Compiler/ModU64.HC
@@ -0,0 +1,13 @@
+public _intern IC_MOD_U64 U64 TestMod(U64 *q,U64 d);
+U64 TestDivisor() {return 7;}
+U64 q=100,r;
+r=TestMod(&q,7);
+if (q!=14 || r!=2) throw('ModConst');
+q=100;
+r=TestMod(&q,TestDivisor());
+if (q!=14 || r!=2) throw('ModCall');
+q=U64_MAX;
+r=TestMod(&q,16);
+if (q!=0x0FFFFFFFFFFFFFFF || r!=15) throw('ModWide');
+"PASS: ModU64\n";
+Exit;
diff --git a/Tests/Compiler/Queues.HC b/Tests/Compiler/Queues.HC
new file mode 100644
index 0000000..6aa3846
--- /dev/null
+++ b/Tests/Compiler/Queues.HC
@@ -0,0 +1,20 @@
+public _intern IC_QUE_INIT U0 TestInit(CQue *q);
+public _intern IC_QUE_INS U0 TestInsert(CQue *a,CQue *b);
+public _intern IC_QUE_INS_REV U0 TestInsertRev(CQue *a,CQue *b);
+public _intern IC_QUE_REM U0 TestRemove(CQue *q);
+CQue head,one,two;
+CQue *TestOne() {return &one;}
+CQue *TestHead() {return &head;}
+TestInit(&head);
+TestInsert(TestOne(),TestHead());
+if (head.next!=&one || one.last!=&head ||
+      one.next!=&head || head.last!=&one) throw('QueueIns');
+TestInsertRev(&two,TestHead());
+if (head.last!=&two || two.next!=&head ||
+      two.last!=&one || one.next!=&two) throw('QueueRev');
+TestRemove(TestOne());
+if (head.next!=&two || two.last!=&head) throw('QueueRem');
+TestRemove(&two);
+if (head.next!=&head || head.last!=&head) throw('QueueEnd');
+"PASS: queues\n";
+Exit;
diff --git a/Tests/Compiler/StrLen.HC b/Tests/Compiler/StrLen.HC
new file mode 100644
index 0000000..f612b06
--- /dev/null
+++ b/Tests/Compiler/StrLen.HC
@@ -0,0 +1,20 @@
+public _intern IC_STRLEN I64 TestStrLen(U8 *text);
+
+U8 *TestText(I64 select)
+{
+  if (select)
+    return "wrong";
+  return "Hello, world!";
+}
+
+if (TestStrLen(TestText(0)) != 13) throw('StrLen');
+
+I64 LengthInRdx(U8 *input)
+{
+  U8 reg RDX *text=input;
+  return TestStrLen(text);
+}
+if (LengthInRdx("Hello, world!") != 13) throw('StrLen');
+if (LengthInRdx("") != 0) throw('StrLen');
+"PASS: StrLen\n";
+Exit;
