+static int64_t X86BitScanRegReg(char *to, int64_t dst, int64_t src,
+                                int64_t reverse) {
+  int64_t len = 0;
+  char buf[16];
+  if (!to)
+    to = buf;
+  ADD_U8(ErectREX(1, dst, 0, src));
+  ADD_U8(0x0f);
+  ADD_U8(reverse ? 0xbd : 0xbc);
+  ADD_U8(MODRMRegReg(dst, src));
+  return len;
+}
+
+static int64_t X86Rdtsc(char *to, int64_t unused) {
+  int64_t len = 0;
+  char buf[16];
+  (void)unused;
+  if (!to)
+    to = buf;
+  ADD_U8(0x0f);
+  ADD_U8(0x31);
+  return len;
