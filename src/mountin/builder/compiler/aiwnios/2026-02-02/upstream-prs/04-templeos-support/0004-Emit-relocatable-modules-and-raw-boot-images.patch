+      if (!StrCmp(label->h->str,cur->hash->str))
+        break;
+    if (label==to_fill && (!fun_name_len ||
+          StrNCmp(cur->hash->str,cc->htc.fun->str,fun_name_len) ||
+          cur->hash->str[fun_name_len]!='.' ||
