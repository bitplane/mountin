From 832db1855e6e1c9f5fe82956fa6bef260c5393fe Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:49 +0100
Subject: [PATCH 30/71] Scope AOT symbol resolution

---
 Src/AsmResolve.HC | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/Src/AsmResolve.HC b/Src/AsmResolve.HC
index 2ba2740..8781c81 100644
--- a/Src/AsmResolve.HC
+++ b/Src/AsmResolve.HC
@@ -88,11 +88,10 @@ CHashExport *AOTResolvedAsmExportFind(CCmpCtrl *cc,U8 *name)
   CHash *entry;
   I64 i;
 
-  for (table=cc->htc.hash_table_lst;table;table=table->next)
-    for (i=0;i<=table->mask;i++)
-      for (entry=table->body[i];entry;entry=entry->next)
-        if (entry->type&HTT_EXPORT_SYS_SYM &&
-              entry->type&HTF_EXPORT &&
+  table=cc->htc.glbl_hash_table;
+  for (i=0;i<=table->mask;i++)
+    for (entry=table->body[i];entry;entry=entry->next)
+      if (entry->type&HTT_EXPORT_SYS_SYM && entry->type&HTF_EXPORT &&
               !(entry->type&HTF_UNRESOLVED) &&
               !StrCmp(entry->str,name))
           return entry;
@@ -123,7 +122,7 @@ U0 AOTGlblsResolve(CCmpCtrl *cc,CAOT *tmpaot)
 	tmpex=tmpauh->hash;
 	if (tmpex->type & HTT_EXPORT_SYS_SYM&& tmpex->type & HTF_UNRESOLVED &&
 	      !(tmpex->type & HTF_IMPORT) &&
-	      (tmpf=HashFind(tmpex->str,cc->htc.hash_table_lst,HTT_FUN)) &&
+	      (tmpf=HashFind(tmpex->str,cc->htc.glbl_hash_table,HTT_FUN)) &&
 	      !Bt(&tmpf->flags,Cf_EXTERN)) {
 	  tmpex->val=tmpf->exe_addr;
 	  tmpex->type&=~HTF_UNRESOLVED;
-- 
2.53.0

