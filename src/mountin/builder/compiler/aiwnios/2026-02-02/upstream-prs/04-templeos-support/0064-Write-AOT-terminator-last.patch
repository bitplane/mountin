From 878cf39f5adf7ace4899dff2b6ec3cf6f670eb1f Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:52 +0100
Subject: [PATCH 64/71] Write AOT terminator last

---
 Src/CMain.HC | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Src/CMain.HC b/Src/CMain.HC
index f97ae7a..655679c 100644
--- a/Src/CMain.HC
+++ b/Src/CMain.HC
@@ -345,7 +345,7 @@ I64 Cmp(U8 *filename,U8 *map_name=NULL,U8 *out_name=NULL,U8 mapfile_drv_let=0,I6
     tmpie=tmpaot->next_ie;
     while (tmpie!=&tmpaot->next_ie) {
       tmpie1=tmpie->next;
-      if (!tmpie->type || IET_REL32_EXPORT<=tmpie->type<=IET_IMM64_EXPORT) {
+      if (IET_REL32_EXPORT<=tmpie->type<=IET_IMM64_EXPORT) {
 	QueRem(tmpie);
 	*ptr++=tmpie->type;
 	*ptr(U32 *)++=tmpie->rip;
@@ -367,6 +367,8 @@ I64 Cmp(U8 *filename,U8 *map_name=NULL,U8 *out_name=NULL,U8 mapfile_drv_let=0,I6
     while (tmpie!=&tmpaot->next_ie) {
       tmpie1=tmpie->next;
       QueRem(tmpie);
+      if (!tmpie->type)
+        goto skip_import;
       *ptr++=tmpie->type;
       if (tmpie->aot)
 	tmpie->rip+=tmpie->aot->rip2;
@@ -382,6 +384,7 @@ I64 Cmp(U8 *filename,U8 *map_name=NULL,U8 *out_name=NULL,U8 mapfile_drv_let=0,I6
 	ptr+=i+1;
       } else
 	*ptr++=0;
+skip_import:
       Free(tmpie->src_link);
       Free(tmpie);
       tmpie=tmpie1;
-- 
