From e099a103bd17369c12b671497ef9d3b88b8021d4 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 10:50:48 +0100
Subject: [PATCH 21/71] Parse assembly import

---
 Src/AsmX64.HC | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/Src/AsmX64.HC b/Src/AsmX64.HC
index 0b9fcc7..69dd56e 100644
--- a/Src/AsmX64.HC
+++ b/Src/AsmX64.HC
@@ -1533,7 +1533,25 @@ enter:
       seg_size=64;
       Lex(cc);
     } else if(!StrCmp(cc->hash_entry->str,"IMPORT")) {
-//TODO
+      Lex(cc);
+      while(cc->token&&cc->token!=';') {
+        if(cc->token!=TK_IDENT)
+          LexExcept(cc,"Expected identifier at");
+        exp=CAlloc(sizeof CHashExport);
+        exp->str=cc->cur_str;
+        cc->cur_str=NULL;
+        exp->type=HTT_EXPORT_SYS_SYM|HTF_UNRESOLVED;
+        HashSrcFileSet(cc,exp);
+        HashAdd(exp,cc->htc.glbl_hash_table);
+        exp->type|=HTF_IMPORT;
+        if(Lex(cc)==',')
+          Lex(cc);
+        else if(cc->token!=';')
+          LexExcept(cc,"Expected ',' or ';' at");
+      }
+      if(cc->token!=';')
+        LexExcept(cc,"Missing ';' at");
+      Lex(cc);
     } else if(!StrCmp(cc->hash_entry->str,"BINFILE")) {
       if(Lex(cc)!=TK_STR)
         LexExcept(cc,"Expected a filename.");
-- 
