From f7b46cf9c904d79d7a9eaddea7f28074977774fe Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 08:48:55 +0100
Subject: [PATCH 2/3] Return success from VFsMountDrive

VFsMountDrive declares an integer result but falls through after recording
the mount point. Return success after completing the registration.
---
 c/fs.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/c/fs.c b/c/fs.c
index 3263f36..8ef5ee8 100644
--- a/c/fs.c
+++ b/c/fs.c
@@ -408,6 +408,7 @@ int VFsMountDrive(char let, char *path) {
   int idx = toupper(let) - 'A';
   char *p = StPCpy(mount_points[idx], path);
   strcpy(p, "/");
+  return 1;
 }
 
 int64_t VFsFBlkRead(void *d, int64_t sz, int f) {
