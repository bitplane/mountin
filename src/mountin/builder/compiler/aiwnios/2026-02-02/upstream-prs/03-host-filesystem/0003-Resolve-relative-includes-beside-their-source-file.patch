From cfc7abb24cccd833dd0e8f4e773cf67009fc6e0d Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 16:51:47 +0100
Subject: [PATCH 3/3] Resolve missing relative includes beside their source file

Preserve current-directory lookup precedence. If that lookup fails for a relative include, search beside the including file. Cover nested includes, parent paths and competing names.
---
 Src/Lex.HC                                   | 8 ++++++++
 Tests/Compiler/IncludeSearch.HC              | 6 ++++++
 Tests/Compiler/IncludeSearch/cwd/value.HC    | 1 +
 Tests/Compiler/IncludeSearch/nested/child.HC | 1 +
 Tests/Compiler/IncludeSearch/parent.HC       | 2 ++
 Tests/Compiler/IncludeSearch/relative.HC     | 1 +
 Tests/Compiler/IncludeSearch/value.HC        | 1 +
 7 files changed, 20 insertions(+)
 create mode 100644 Tests/Compiler/IncludeSearch.HC
 create mode 100644 Tests/Compiler/IncludeSearch/cwd/value.HC
 create mode 100644 Tests/Compiler/IncludeSearch/nested/child.HC
 create mode 100644 Tests/Compiler/IncludeSearch/parent.HC
 create mode 100644 Tests/Compiler/IncludeSearch/relative.HC
 create mode 100644 Tests/Compiler/IncludeSearch/value.HC

diff --git a/Src/Lex.HC b/Src/Lex.HC
index bb6aeff..fe9262d 100644
--- a/Src/Lex.HC
+++ b/Src/Lex.HC
@@ -701,6 +701,14 @@ lex_float_start:
 	      goto lex_end;
 	    fbuf=ExtDft(cc->cur_str,"HC.Z");
 	    buf2=FileNameAbs(fbuf);
+	    if (!FileFind(buf2) && *fbuf!='/' && !StrOcc(fbuf,':') &&
+		cc->lex_include_stk && cc->lex_include_stk->full_name) {
+	      buf3=StrNew(cc->lex_include_stk->full_name);
+	      StrLastRem(buf3,"/");
+	      Free(buf2);
+	      buf2=MStrPrint("%s/%s",buf3,fbuf);
+	      Free(buf3);
+	    }
 	    Free(fbuf);
 	    if (!TEXT_MODE) //TODO Was 1  TODO RESTORE 
 	      LexAttachDoc(cc,,,buf2);
diff --git a/Tests/Compiler/IncludeSearch.HC b/Tests/Compiler/IncludeSearch.HC
new file mode 100644
index 0000000..21ce17f
--- /dev/null
+++ b/Tests/Compiler/IncludeSearch.HC
@@ -0,0 +1,6 @@
+Cd("/Tests/Compiler/IncludeSearch/cwd");
+#include "IncludeSearch/parent.HC"
+if (INCLUDE_PRECEDENCE!=22 || INCLUDE_RELATIVE!=33)
+  throw('Include');
+"PASS: IncludeSearch\n";
+Exit;
diff --git a/Tests/Compiler/IncludeSearch/cwd/value.HC b/Tests/Compiler/IncludeSearch/cwd/value.HC
new file mode 100644
index 0000000..5b3160f
--- /dev/null
+++ b/Tests/Compiler/IncludeSearch/cwd/value.HC
@@ -0,0 +1 @@
+#define INCLUDE_PRECEDENCE 22
diff --git a/Tests/Compiler/IncludeSearch/nested/child.HC b/Tests/Compiler/IncludeSearch/nested/child.HC
new file mode 100644
index 0000000..9db42bc
--- /dev/null
+++ b/Tests/Compiler/IncludeSearch/nested/child.HC
@@ -0,0 +1 @@
+#include "../relative.HC"
diff --git a/Tests/Compiler/IncludeSearch/parent.HC b/Tests/Compiler/IncludeSearch/parent.HC
new file mode 100644
index 0000000..72ff138
--- /dev/null
+++ b/Tests/Compiler/IncludeSearch/parent.HC
@@ -0,0 +1,2 @@
+#include "value.HC"
+#include "nested/child.HC"
diff --git a/Tests/Compiler/IncludeSearch/relative.HC b/Tests/Compiler/IncludeSearch/relative.HC
new file mode 100644
index 0000000..ac04f52
--- /dev/null
+++ b/Tests/Compiler/IncludeSearch/relative.HC
@@ -0,0 +1 @@
+#define INCLUDE_RELATIVE 33
diff --git a/Tests/Compiler/IncludeSearch/value.HC b/Tests/Compiler/IncludeSearch/value.HC
new file mode 100644
index 0000000..bb5dd72
--- /dev/null
+++ b/Tests/Compiler/IncludeSearch/value.HC
@@ -0,0 +1 @@
+#define INCLUDE_PRECEDENCE 11
