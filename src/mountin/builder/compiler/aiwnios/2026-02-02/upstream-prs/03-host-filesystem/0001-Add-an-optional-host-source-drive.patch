From 9dce06f390feb7e3ca24c79916a2c49adb7a06d3 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 08:48:54 +0100
Subject: [PATCH 1/2] Add an optional host source drive

---
 Src/DskAddDev.HC | 2 ++
 Src/Lex.HC       | 8 ++++++++
 c/main.c         | 8 +++++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/Src/DskAddDev.HC b/Src/DskAddDev.HC
index ce77c26..5663652 100644
--- a/Src/DskAddDev.HC
+++ b/Src/DskAddDev.HC
@@ -201,6 +201,8 @@ U0 BlkDevsInitAll()
   }
   bd=BlkDevNextFreeSlot('T',BDT_VIRT);bd->unit=0;
   BlkDevAdd(bd,0,0,0);
+  bd=BlkDevNextFreeSlot('U',BDT_VIRT);bd->unit=0;
+  BlkDevAdd(bd,0,0,0);
   Fs->cur_dv=Let2Drv('T');
   Fs->cur_dir=StrNew("/");
   blkdev.boot_drv_let='T';
diff --git a/Src/Lex.HC b/Src/Lex.HC
index bb6aeff..fe9262d 100644
--- a/Src/Lex.HC
+++ b/Src/Lex.HC
@@ -701,6 +701,14 @@ lex_float_start:
 	      goto lex_end;
 	    fbuf=ExtDft(cc->cur_str,"HC.Z");
 	    buf2=FileNameAbs(fbuf);
+	    if (!FileFind(buf2) && *fbuf!='/' && !StrOcc(fbuf,':') &&
+		cc->lex_include_stk && cc->lex_include_stk->full_name) {
+	      buf3=StrNew(cc->lex_include_stk->full_name);
+	      StrLastRem(buf3,"/");
+	      Free(buf2);
+	      buf2=MStrPrint("%s/%s",buf3,fbuf);
+	      Free(buf3);
+	    }
 	    Free(fbuf);
 	    if (!TEXT_MODE) //TODO Was 1  TODO RESTORE 
 	      LexAttachDoc(cc,,,buf2);
diff --git a/c/main.c b/c/main.c
index f7f74b6..560924d 100644
--- a/c/main.c
+++ b/c/main.c
@@ -72,7 +72,8 @@ int64_t sdl_window_grab_enable = 0;
 struct arg_lit *arg_help, *arg_overwrite, *arg_new_boot_dir, *arg_asan_enable,
     *sixty_fps, *arg_cmd_line, *arg_cmd_line2 = NULL, *arg_fork, *arg_no_debug,
                                *arg_grab, *arg_fast_fail, *arg_s;
-struct arg_file *arg_t_dir, *arg_bootstrap_bin, *arg_boot_files, *arg_pidfile;
+struct arg_file *arg_t_dir, *arg_host_dir, *arg_bootstrap_bin,
+    *arg_boot_files, *arg_pidfile;
 static struct arg_end *_arg_end;
 #ifdef AIWNIOS_TESTS
 // Import PrintI first
@@ -1941,6 +1942,8 @@ static int64_t Boot(int64_t *) {
   }
   InstallDbgSignalsForThread();
   VFsMountDrive('T', t_drive);
+  if (arg_host_dir->count)
+    VFsMountDrive('U', (char *)arg_host_dir->filename[0]);
 #if defined(__EMSCRIPTEN__)
   EM_ASM(FS.mkdir('/persist'); FS.mount(IDBFS, {}, '/persist');
          FS.syncfs(true, function(err){}););
@@ -2075,6 +2078,9 @@ int main(int argc, char **argv) {
                    "Overwrite the T directory with the installed T template."),
       arg_t_dir = arg_file0("t", NULL, "Directory",
                             "Specify the boot drive(dft is current dir)."),
+      arg_host_dir =
+          arg_file0("U", "host-drive", "Directory",
+                    "Mount a host directory as the U drive."),
       arg_bootstrap_bin =
           arg_lit0("b", "bootstrap",
                    "Build a new binary with the \"slim\" compiler of aiwnios."),
-- 
