From ced4def4beea64b518314a6149191cfb91a146f9 Mon Sep 17 00:00:00 2001
From: Gareth Davidson <gaz@bitplane.net>
Date: Sun, 6 Sep 2026 16:51:47 +0100
Subject: [PATCH 1/3] Add an optional host source drive

Mount the directory supplied by --host-drive at U. Expose mounted-drive state to HolyC so only configured host drives are registered.
---
 Src/DskAddDev.HC             |  7 +++++--
 Src/KernelA.HH               |  2 ++
 Tests/Compiler/HostDrives.HC |  9 +++++++++
 c/aiwn_fs.h                  |  1 +
 c/fs.c                       |  5 +++++
 c/main.c                     | 13 ++++++++++++-
 6 files changed, 34 insertions(+), 3 deletions(-)
 create mode 100644 Tests/Compiler/HostDrives.HC

diff --git a/Src/DskAddDev.HC b/Src/DskAddDev.HC
index ce77c26..33634ae 100644
--- a/Src/DskAddDev.HC
+++ b/Src/DskAddDev.HC
@@ -199,8 +199,11 @@ U0 BlkDevsInitAll()
   for (i=0;i<DRVS_NUM;i++) {
     blkdev.let_to_drv[i]=&blkdev.drvs[i];
   }
-  bd=BlkDevNextFreeSlot('T',BDT_VIRT);bd->unit=0;
-  BlkDevAdd(bd,0,0,0);
+  for (i='A';i<='Z';i++)
+    if (VFsDriveMounted(i)) {
+      bd=BlkDevNextFreeSlot(i,BDT_VIRT);bd->unit=0;
+      BlkDevAdd(bd,0,0,0);
+    }
   Fs->cur_dv=Let2Drv('T');
   Fs->cur_dir=StrNew("/");
   blkdev.boot_drv_let='T';
diff --git a/Src/KernelA.HH b/Src/KernelA.HH
index 4a3693b..60e692c 100644
--- a/Src/KernelA.HH
+++ b/Src/KernelA.HH
@@ -3967,6 +3967,7 @@ import I64 VFsFBlkWrite(U8i*,I64i,I64i,U8i*);
 import I64 VFsFSeek(I64i,U8i*);
 import U0 VFsSetPwd(U8i*);
 import U0 VFsSetDrv(U8i);
+import Bool VFsDriveMounted(U8i);
 import Bool VFsExists(U8i*);
 import Bool VFsIsDir(U8i*);
 import I64i VFsFSize(U8i*);
@@ -4113,6 +4114,7 @@ extern I64 VFsFBlkWrite(U8i*,I64i,I64i,U8i*);
 extern I64 VFsFSeek(I64i,U8i*);
 extern U0 VFsSetPwd(U8i*);
 extern U0 VFsSetDrv(U8i);
+extern Bool VFsDriveMounted(U8i);
 extern Bool VFsExists(U8i*);
 extern Bool VFsIsDir(U8i*);
 extern I64i VFsFSize(U8i*);
diff --git a/Tests/Compiler/HostDrives.HC b/Tests/Compiler/HostDrives.HC
new file mode 100644
index 0000000..6858610
--- /dev/null
+++ b/Tests/Compiler/HostDrives.HC
@@ -0,0 +1,9 @@
+I64 drive;
+for (drive='A';drive<='Z';drive++)
+  if (!!Let2Drv(drive,FALSE)!=VFsDriveMounted(drive))
+    throw('HostDrv');
+if (!VFsDriveMounted('T') || !VFsDriveMounted('t') ||
+    VFsDriveMounted(0) || VFsDriveMounted('?'))
+  throw('HostDrv');
+"PASS: HostDrives\n";
+Exit;
diff --git a/c/aiwn_fs.h b/c/aiwn_fs.h
index 4010ac9..1994f24 100644
--- a/c/aiwn_fs.h
+++ b/c/aiwn_fs.h
@@ -5,6 +5,7 @@ char *FileRead(char *fn, int64_t *sz);
 
 void VFsThrdInit();
 void VFsSetDrv(char d);
+int VFsDriveMounted(char d);
 int64_t VFsDel(char *p);
 int64_t VFsUnixTime(char *name);
 int64_t VFsFSize(char *name);
diff --git a/c/fs.c b/c/fs.c
index d11675e..3263f36 100644
--- a/c/fs.c
+++ b/c/fs.c
@@ -135,6 +135,11 @@ void VFsSetDrv(char d) {
   thrd_drv = toupper(d);
 }
 
+int VFsDriveMounted(char d) {
+  int idx = toupper((unsigned char)d) - 'A';
+  return idx >= 0 && idx < 26 && mount_points[idx][0] != 0;
+}
+
 static bool VFsCd(char *to, bool make) {
   to = __VFsFileNameAbs(to);
   if (__FExists(to) && __FIsDir(to))
diff --git a/c/main.c b/c/main.c
index f7f74b6..ff39c88 100644
--- a/c/main.c
+++ b/c/main.c
@@ -72,7 +72,8 @@ int64_t sdl_window_grab_enable = 0;
 struct arg_lit *arg_help, *arg_overwrite, *arg_new_boot_dir, *arg_asan_enable,
     *sixty_fps, *arg_cmd_line, *arg_cmd_line2 = NULL, *arg_fork, *arg_no_debug,
                                *arg_grab, *arg_fast_fail, *arg_s;
-struct arg_file *arg_t_dir, *arg_bootstrap_bin, *arg_boot_files, *arg_pidfile;
+struct arg_file *arg_t_dir, *arg_host_dir, *arg_bootstrap_bin,
+    *arg_boot_files, *arg_pidfile;
 static struct arg_end *_arg_end;
 #ifdef AIWNIOS_TESTS
 // Import PrintI first
@@ -1290,6 +1291,10 @@ static int64_t STK_VFsFSeek(int64_t *stk) {
 static int64_t STK_VFsSetDrv(int64_t *stk) {
   VFsSetDrv(stk[0]);
 }
+
+static int64_t STK_VFsDriveMounted(int64_t *stk) {
+  return VFsDriveMounted(stk[0]);
+}
 static int64_t STK_VFsUnixTime(int64_t *stk) {
   return VFsUnixTime(stk[0]);
 }
@@ -1827,6 +1832,7 @@ static void BootAiwnios(char *bootstrap_text) {
     PrsAddSymbol("VFsFClose", STK_VFsFClose, 1);
     PrsAddSymbol("VFsFSeek", STK_VFsFSeek, 2);
     PrsAddSymbol("VFsSetDrv", STK_VFsSetDrv, 1);
+    PrsAddSymbol("VFsDriveMounted", STK_VFsDriveMounted, 1);
     PrsAddSymbol("FUnixTime", STK_VFsUnixTime, 1);
     PrsAddSymbol("FSize", STK_VFsFSize, 1);
     PrsAddSymbol("VFsFTrunc", STK_VFsTrunc, 2);
@@ -1941,6 +1947,8 @@ static int64_t Boot(int64_t *) {
   }
   InstallDbgSignalsForThread();
   VFsMountDrive('T', t_drive);
+  if (arg_host_dir->count)
+    VFsMountDrive('U', (char *)arg_host_dir->filename[0]);
 #if defined(__EMSCRIPTEN__)
   EM_ASM(FS.mkdir('/persist'); FS.mount(IDBFS, {}, '/persist');
          FS.syncfs(true, function(err){}););
@@ -2075,6 +2083,9 @@ int main(int argc, char **argv) {
                    "Overwrite the T directory with the installed T template."),
       arg_t_dir = arg_file0("t", NULL, "Directory",
                             "Specify the boot drive(dft is current dir)."),
+      arg_host_dir =
+          arg_file0("U", "host-drive", "Directory",
+                    "Mount a host directory as the U drive."),
       arg_bootstrap_bin =
           arg_lit0("b", "bootstrap",
                    "Build a new binary with the \"slim\" compiler of aiwnios."),
