diff --git a/Tests/Compiler/X86Aliases.HC b/Tests/Compiler/X86Aliases.HC
new file mode 100644
--- /dev/null
+++ b/Tests/Compiler/X86Aliases.HC
@@ -0,0 +1,17 @@
+I64 opts=0,i;
+U8 expected[31]={0x9c,0x66,0x9c,0x9d,0x66,0x9d,0x60,0x66,0x60,0x61,0x66,0x61,
+      0x66,0x9c,0x9c,0x66,0x9d,0x9d,0x66,0x60,0x60,0x66,0x61,0x61,
+      0x9b,0x48,0xdf,0xe0,0x9b,0xdf,0xe0};
+DirMk("/Tmp");
+Bts(&opts,OPTf_RAW_AOT);
+if (Cmp("/Tests/Compiler/X86AliasesInput.HC",,"/Tmp/Aliases.BIN",0,opts))
+  throw('AsmError');
+CBinFile *bin=FileRead("/Tmp/Aliases.BIN");
+U8 *code=bin(U8 *)+sizeof(CBinFile);
+if (bin->patch_table_offset-sizeof(CBinFile)!=sizeof(expected))
+  throw('AsmSize');
+for (i=0;i<sizeof(expected);i++)
+  if (code[i]!=expected[i]) throw('AsmBytes');
+Free(bin);
+"PASS: x86 aliases\n";
+Exit;
