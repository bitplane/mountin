diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -44,5 +44,8 @@ KERNEL_MODULE   = bin${SEP}${COMPONENT}
 ASFLAGS        += -PD "FreezeDevRel SETL {${FREEZE_DEV_REL}}" -PD "USE_SYNCLIB SETL {${USE_SYNCLIB}}" -PD "RISCOS_KERNEL SETL {TRUE}"
 ifeq (GNU,${TOOLCHAIN})
+# GNU ld relocates a cross-area symbol difference by the text base. Tell the
+# source to compensate where the embedded UtilityModule length is emitted.
+ASFLAGS        += -PD "GNU_LD SETL {TRUE}"
 CFLAGS         += -DRISCOS_KERNEL -mno-apcs-stack-check
 else
 CFLAGS         += -ff -APCS 3/32bit/nofp/noswst -DRISCOS_KERNEL
diff --git a/s/Utility b/s/Utility
--- a/s/Utility
+++ b/s/Utility
@@ -18,7 +18,11 @@
 ; Arthur Utility commands
 
 SysModules_Info ROUT     ; start of ROM modules chain
+      [ :DEF: GNU_LD
+        &       (EndOfKernelRW-RWBase)+EndOfKernelRO-SysModules_Info-KernelBaseA
+      |
         &       (EndOfKernelRW-RWBase)+EndOfKernelRO-SysModules_Info
+      ]
 
 UtilityMod
 Module_BaseAddr
