+static LONG rawMayGetChar(void)
+{
+    if ((uart[PL011_FR / sizeof(*uart)] & PL011_FR_RXFE) == 0)
+        return uart[PL011_DR / sizeof(*uart)] & 0xff;
+
+    return -1;
+}
